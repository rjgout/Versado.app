# --- Poort waarop de app bereikbaar is ---
PORT=3000

# --- PostgreSQL ---
# Bij gebruik van docker-compose.yml worden deze automatisch samengevoegd
# tot de juiste DATABASE_URL voor jehova-app (zie docker-compose.yml) — je
# hoeft DATABASE_URL zelf dus niet te zetten in die opzet. De gebruiker/
# database heten bewust "bom" (niet "jehova") — dat is voor niemand
# zichtbaar en zo hoeft een bestaande installatie de database zelf niet te
# hernoemen bij het overzetten naar de nieuwe containernamen.
POSTGRES_USER=bom
POSTGRES_PASSWORD=__VERVANG_DIT__
POSTGRES_DB=bom

# --- Redis (Socket.io-adapter voor de live multiplayer-quiz) ---
REDIS_PASSWORD=__VERVANG_DIT__

# --- Sessies ---
# Genereer een eigen, geheime waarde, bv. met: openssl rand -hex 32
SESSION_SECRET=__VERVANG_DIT__

# Alleen op "true" zetten om te testen via een plain-http-adres, zoals het
# LAN-IP van je NAS (bv. http://192.168.x.x:PORT). Zonder dit blijft inloggen
# daar hangen, omdat de browser een Secure-cookie negeert op een http-pagina.
# NOOIT aanzetten zodra de app via je echte (https-)domein bereikbaar is.
ALLOW_INSECURE_COOKIES=false

# Optioneel: het publieke adres van je installatie (bv. https://jehova.jouwdomein.nl),
# gebruikt om de link in bevestigings-/wachtwoordreset-e-mails op te bouwen.
# Weggelaten? Dan wordt dit automatisch afgeleid van het inkomende verzoek
# (werkt ook prima achter een reverse proxy/Cloudflare Tunnel).
# APP_URL=https://jehova.jouwdomein.nl

# De SMTP-instellingen voor uitgaande e-mail (accountbevestiging,
# wachtwoordreset) stel je in via /adminbackend in de app zelf, niet hier —
# zo kan je dat aanpassen zonder te herdeployen.

# Optioneel: geeft toegang tot de leesalleen content-API onder /api/content-api/*
# (bv. voor Claude Code om live contentstatus te checken/content te genereren
# zonder in te loggen) — zie CLAUDE.md, sectie "Content-API". Nooit gebruikers-
# of persoonsgegevens, uitsluitend content (boeken/hoofdstukken/oefeningen/
# personages/podcastafleveringen e.d.). Leeg laten = de content-API staat
# helemaal uit (elk verzoek krijgt 401, ongeacht de meegestuurde sleutel).
# Genereer een eigen, geheime waarde, bv. met: openssl rand -hex 32
# CONTENT_API_KEY=__VERVANG_DIT__

# Afgeschermd technisch prototype van Versado Dorp. De route vereist daarnaast
# altijd een ingelogde beheerder en verschijnt niet in de publieke spelcatalogus.
VERSADO_DORP_PROTOTYPE_ENABLED=false

# Optioneel: alleen zetten als de podcastfeed ooit naar een andere URL
# verhuist. Standaard https://geloofjedatook.nl/@geloofjedatook/feed.xml —
# wordt bij elke content-import (db:seed) opgehaald voor titels/omschrijvingen
# van nieuwe afleveringen.
# PODCAST_FEED_URL=https://geloofjedatook.nl/@geloofjedatook/feed.xml

# --- Alleen nodig als je de app NIET via docker-compose.yml draait, dus
# rechtstreeks met `npm run dev` / `npm start` op je eigen machine tegen
# een losse Postgres/Redis (lokaal of elders) ---
# DATABASE_URL="postgresql://bom:wachtwoord@localhost:5432/bom?schema=public"
# REDIS_URL="redis://:wachtwoord@localhost:6379"

# Studielesmedia: echte persistente mount + eenmalige volumemarker verplicht.
# Geen tijdelijke fallback; officiële adapters/publicatie nog niet vrijgegeven.
STUDY_MEDIA_DIR=/data/study-media

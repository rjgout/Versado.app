# Voorbeeld van de Portainer-stackvariabelen voor deploy/test-stack/docker-compose.yml.
# Plaatsaanduidingen, GEEN echte waarden en GEEN domein. Kopieer dit niet naar git met ingevulde geheimen.
# Genereer geheimen met:  openssl rand -hex 32   (elk geheim anders, en anders dan productie)

# Vaste tag of commit van de image (niet "latest"):
APP_IMAGE_TAG=
# Een vrije poort op de NAS die productie niet gebruikt:
TEST_PROXY_PORT=
# De HTTPS-oorsprong van de teststack, pas na inrichting van DNS en TLS (exact, zonder slash, zonder pad):
TEST_APP_URL=
TEST_POSTGRES_PASSWORD=
TEST_REDIS_PASSWORD=
TEST_SESSION_SECRET=
TEST_NATIVE_SESSION_SECRET=

# Optioneel, pas na de Apple-configuratie van de eigenaar:
# TEST_APPLE_SIGN_IN_ENABLED=1
# TEST_APPLE_TEAM_ID=
# TEST_APPLE_IOS_CLIENT_ID=app.versado.app

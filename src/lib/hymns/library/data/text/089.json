 "stanzas": [
  {
   "lines": [
    "Liefderijk Vader, hoor, alom op aarde",
    "danken uw kind’ren dat G’ in hen bewaarde",
    "vrede des harten, uw volkomen vrede,",
    "eeuwige vrede."
   ],
   "n": 1
  },
  {
   "lines": [
    "Dat Gij in ’t hart steeds ons die vreê blijft geven;",
    "vreugde voor zielen die in wanhoop leven,",
    "moedig vertrouwend in uw vreed’ oneindig,",
    "eind’loze vrede."
   ],
   "n": 2
  },
  {
   "lines": [
    "God onzer vaad’ren, sterk elk volk in vrede;",
    "uw vrede slechts brengt welzijn met zich mede.",
    "Moge de wereld glorierijk verrijzen,",
    "eeuwig U prijzen."
   ],
   "n": 3
  }
 ],
 "subtitle": null,
 "tempoLabel": "Als een gebed",
 "textCredit": "naar Angus S. Hibbard",
 "title": "Liefderijk Vader"
}

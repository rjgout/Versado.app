 "stanzas": [
  {
   "lines": [
    "Wij houden veel, o Heer, van uw gewijde huis;",
    "zijn geestelijke sfeer sluit buiten ’t aards gedruis."
   ],
   "n": 1
  },
  {
   "lines": [
    "Het is een huis van rust, van orde en gebed.",
    "Hier worden wij bewust van uw verheven wet."
   ],
   "n": 2
  },
  {
   "lines": [
    "Wij houden van uw woord, dat vreugd en vrede sticht;",
    "het leidt ons door dit oord naar zaligheid en licht."
   ],
   "n": 3
  }
 ],
 "subtitle": null,

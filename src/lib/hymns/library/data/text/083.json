 "stanzas": [
  {
   "lines": [
    "O, wees need’rig in uw zwakheid en de Here zal u leiden,",
    "u leiden aan de hand en steeds verhoren uw gebed.",
    "O, wees need’rig in uw smeken en de Here zal u zeeg’nen,",
    "u zeeg’nen met vertrouwen dat Hij altijd op u let."
   ],
   "n": 1
  },
  {
   "lines": [
    "O, wees need’rig in uw roeping en de Here zal u leren",
    "zijn kind’ren blij te dienen met een liefde zacht en rein.",
    "O, wees need’rig in uw streven en de Here zal u voeren,",
    "u voeren naar zijn woning en voor eeuwig bij u zijn."
   ],
   "n": 2
  }
 ],
 "subtitle": null,

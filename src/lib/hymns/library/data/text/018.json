 "stanzas": [
  {
   "lines": [
    "Wil uw profeet, o Heer,",
    "verlenen immermeer",
    "uw zegen rijk.",
    "Wil branden in ons hart",
    "zijn nobel woord,",
    "opdat wij kiezen ’t goede pad",
    "in deugdzaamheid."
   ],
   "n": 1
  },
  {
   "lines": [
    "Zo gaat uw koninkrijk,",
    "aan Daniëls steen gelijk,",
    "van kust tot kust.",
    "Die grote broederband,",
    "vereend in uwe hand,",
    "omvat eens ieder land",
    "in vreugd en rust."
   ],
   "n": 2
  },
  {
   "lines": [
    "O, maak uw volk beneên",
    "als Zoon en Vader één,",
    "is onze beê.",
    "Verenigd gaan wij voort",
    "tot ieder heeft gehoord",
    "dit wonderbare woord",
    "van heil en vreê."
   ],
   "n": 3
  }
 ],
 "subtitle": null,
 "tempoLabel": "Als een gebed",
 "textCredit": "naar Bernard Snow (1822–1894)",
 "title": "Zegen uw profeet, o Heer"
}

 "stanzas": [
  {
   "lines": [
    "Hoog op der bergen kruin,",
    "daar wappert een banier,",
    "kom, hoor naar de bazuin,",
    "de ware leer is hier.",
    "In Zions schoon en vreedzaam land,",
    "daar op een berg is zij geplant."
   ],
   "n": 1
  },
  {
   "lines": [
    "Want God gedenkt nu weer",
    "’tgeen Hij gesproken had:",
    "Door waarheid triomfeer,",
    "gij schone Zionstad!",
    "Uw godd’lijk licht spreidt gij ten toon",
    "tot heel de wereld dient mijn Zoon."
   ],
   "n": 2
  },
  {
   "lines": [
    "Zijn huis werd daar gebouwd;",
    "de volk’ren zullen zien",
    "zijn heerlijkheid ontvouwd",
    "en dan tot Zion vliên.",
    "Laat ons dan gaan waar onze God",
    "ons leert zijn wet en zijn gebod."
   ],
   "n": 3
  },
  {
   "lines": [
    "Vandaar, als is voorzegd,",
    "gaat uit des Heren wet,",
    "vol waarheid, wijsheid, recht,",
    "waarop heel d’aard’ eens let.",
    "Wij dienen Hem voor altijd daar",
    "en redden ook de dodenschaar."
   ],
   "n": 4
  }
 ],
 "subtitle": null,
 "tempoLabel": "Resoluut",
 "textCredit": "naar Joel H. Johnson (1802–1882)",
 "title": "Hoog op der bergen kruin"
}

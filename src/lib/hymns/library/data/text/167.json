   "lines": [
    "Uitgekozen Hem altijd te dienen;",
    "als getuige van zijn grote naam",
    "spreken wij van onze Hemelvader,",
    "van zijn liefde en zijn faam."
   ],
   "n": 1
  },
  {
   "chorus": 0,
   "lines": [
    "Rijk gezegend met zijn milde gaven,",
    "kind’ren van een goddelijke Heer,",
    "vreugdevol zijn heil’ge naam belijdend,",
    "brengen wij Hem lof en eer."
   ],
   "n": 2
  }
 ],

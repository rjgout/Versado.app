 "stanzas": [
  {
   "lines": [
    "Help mij bij het onderwijzen,",
    "geef mij inspiratie, Heer.",
    "Help mij anderen verheffen",
    "naar een hoger, eed’ler sfeer."
   ],
   "n": 1
  },
  {
   "lines": [
    "Als een vriend verlaten ronddwaalt",
    "en de nacht belet zijn zicht,",
    "zend mij dan om hem te vinden",
    "en te leiden naar het licht."
   ],
   "n": 2
  },
  {
   "lines": [
    "Vul mijn geest met mededogen;",
    "laat uw wil de mijne zijn,",
    "raak mijn hand met hechte vriendschap,",
    "vul mijn hart met liefde rein."
   ],
   "n": 3
  },
  {
   "lines": [
    "Laat mij toch uw lamm’ren hoeden",
    "en ’t verloor’ne brengen weer.",
    "Als een herder wil ’k U dienen;",
    "leer m’ uw schapen weiden, Heer."
   ],
   "n": 4
  }
 ],
 "subtitle": null,
 "tempoLabel": "Vurig",
 "textCredit": "naar Lorin F. Wheelwright (1909–1987)",
 "title": "Help mij bij het onderwijzen"
}

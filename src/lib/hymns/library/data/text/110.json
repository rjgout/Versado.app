 "stanzas": [
  {
   "lines": [
    "O, grote Heer, met dankbaar hart zing ik tot U dit avondlied.",
    "Laat uw genade dragen de toon naar uw verheven hemels gebied."
   ],
   "n": 1
  },
  {
   "lines": [
    "Iedere dag die Gij mij gunt, ja, ieder uur dat ik verblijf,",
    "tonen uw gunst en eind’loos geduld waarmee G’ uw liefde onderschrijft."
   ],
   "n": 2
  },
  {
   "lines": [
    "Met hoop in U sluit ik mijn oog; laat mij in uw zorg rusten, Heer.",
    "Moge mijn slaap verkwikkend zijn tot ik ontwaak met dank, U ter eer."
   ],
   "n": 3
  }
 ],
 "subtitle": null,
 "tempoLabel": "Als een gebed",
 "textCredit": "naar Anne Steele (1716–1778)",
 "title": "Een avondlied"
}

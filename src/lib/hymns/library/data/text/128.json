 "stanzas": [
  {
   "lines": [
    "Hij stierf! De grote Redder stierf,",
    "en Isr’els dochters weenden luid.",
    "De hemel werd in nacht gehuld,",
    "en d’aarde brak in beven uit."
   ],
   "n": 1
  },
  {
   "lines": [
    "Komt, heil’gen komt en stort een traan",
    "voor Hem die willig droeg uw last.",
    "Hij stortte zijn onschuldig bloed,",
    "waardoor Hij van de zond’ u wast."
   ],
   "n": 2
  },
  {
   "lines": [
    "De Heer des hemels stierf voor ons,",
    "met liefd’ en smart oneindig groot.",
    "Maar o, wat jubel werd gehoord",
    "toen Hij verrees na kruis en dood."
   ],
   "n": 3
  },
  {
   "lines": [
    "Des levens Heer verliet het graf,",
    "Hem houden kon des doods macht niet.",
    "Een eng’lenheer geleidde hem",
    "en zong Hem toe een welkomstlied."
   ],
   "n": 4
  }
 ],
 "subtitle": null,
 "tempoLabel": "Innig",
 "textCredit": "naar Isaac Watts (1674–1748)",
 "title": "Hij stierf! De grote Redder stierf"
}

 "stanzas": [
  {
   "chorus": 0,
   "lines": [
    "Voor g’ uw woning hadt verlaten,",
    "dacht gij aan ’t gebed?",
    "Badt gij in de naam des Heren",
    "onheil van u af te weren,",
    "waar g’ uw voet ook zet?"
   ],
   "n": 1
  },
  {
   "chorus": 0,
   "lines": [
    "Toen uw hart met toorn vervuld was,",
    "dacht gij aan ’t gebed?",
    "Badt gij toen ook om genade,",
    "te vergeven hem die ’t kwade",
    "voor u had gezet?"
   ],
   "n": 2
  },
  {
   "chorus": 0,
   "lines": [
    "Toen beproeving was gekomen,",
    "dacht gij aan ’t gebed?",
    "Toen uw ziel vol was van smarte,",
    "vroegt gij balsem voor het harte",
    "Hem, die helpt en redt?"
   ],
   "n": 3
  }
 ],
 "subtitle": null,
 "tempoLabel": "Bedachtzaam",
 "textCredit": "naar Mary A. Pepper Kidder (1820–1905)",
 "title": "Dacht gij aan ’t gebed?"
}

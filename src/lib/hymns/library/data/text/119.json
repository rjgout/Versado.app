 "stanzas": [
  {
   "chorus": 0,
   "lines": [
    "Kom, stijg’ ons lied van dank en lof",
    "tot Hem die daald’ uit ’s hemels hof,",
    "en die uit liefde zonder peil",
    "hier leed en stierf voor ’s mensen heil."
   ],
   "n": 1
  },
  {
   "chorus": 0,
   "lines": [
    "’t Is goed dat elke sabbat weer",
    "het avondmaal van onze Heer,",
    "zoals door Hem werd ingesteld,",
    "ons groot geloof in Hem vermeldt."
   ],
   "n": 2
  },
  {
   "chorus": 0,
   "lines": [
    "Schoon uur van vreugd en liefde rein,",
    "als groot en klein verenigd zijn,",
    "en elk verheugd met hart en stem",
    "zijn loflied zingt ter eer van Hem."
   ],
   "n": 3
  }
 ],

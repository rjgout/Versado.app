 "stanzas": [
  {
   "lines": [
    "Vader, hoort Gij onze beê,",
    "schenk ons nu des hemels vreê;",
    "teek’nen van zijn vlees en bloed",
    "brengen ’s Heilands liefde zoet."
   ],
   "n": 1
  },
  {
   "lines": [
    "Schenk ons, Vader, uw genâ,",
    "sla ons met ontferming gâ,",
    "als wij eten van het brood,",
    "zend tot ons uw vrede groot."
   ],
   "n": 2
  },
  {
   "lines": [
    "Drinken wij het water rein,",
    "laat uw Geest dan met ons zijn.",
    "Scheld ons onze fouten kwijt,",
    "sterk ons streven t’ allen tijd’."
   ],
   "n": 3
  }
 ],

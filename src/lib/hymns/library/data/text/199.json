   "lines": [
    "Zoals ’k u liefheb,",
    "houd van elkander.",
    "Dit nieuw gebod luidt:",
    "houd van elkander.",
    "Zo weten allen:",
    "gij zijt mijn discip’len,",
    "indien gij houdt",
    "van elkander."
   ],

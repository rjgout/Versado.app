  {
   "chorus": 0,
   "lines": [
    "Heer, met uw eng’len ons hart zij verheugd,",
    "help ons te zingen met innige vreugd:"
   ],
   "n": 3
  },
  {
   "chorus": 0,
   "lines": [
    "Geef dat van ’t mensdom uit ieder oord,",
    "dra wordt vernomen dit eng’lenwoord:"
   ],
   "n": 4
  }

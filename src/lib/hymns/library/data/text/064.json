 "stanzas": [
  {
   "lines": [
    "Dankt, dankt nu allen God",
    "met blijde feestgezangen.",
    "Van Hem is ’t heug’lijk lot,",
    "het heil dat wij ontvangen.",
    "Hij is de God der goôn",
    "en spoort tot liefd’ ons aan.",
    "Hij heeft ons dag aan dag",
    "met goedheid overlaân."
   ],
   "n": 1
  },
  {
   "lines": [
    "Moog’ onze milde God",
    "voortdurend ons geleiden;",
    "met vreed’ ons aardse lot",
    "door liefd’ en licht verblijden.",
    "Hij, onze Toeverlaat,",
    "zij met ons dag en nacht,",
    "redd’ ons van alle kwaad,",
    "bescherm’ ons door zijn macht."
   ],
   "n": 2
  }
 ],

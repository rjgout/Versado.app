 "stanzas": [
  {
   "lines": [
    "God onzer vaad’ren, wiens almacht’ge hand",
    "leidt voort de baan der sterren en hun stand,",
    "stuurt de planeten in het gans heelal,",
    "uw grote kracht bewijst zich overal."
   ],
   "n": 1
  },
  {
   "lines": [
    "Uw liefde heeft ons in ’t verleên geleid;",
    "leid ons, o Heer, ook nu in deze tijd!",
    "Wees onze Gids, Beschermer, Rots en Borg,",
    "hoedt Gij ons immer in uw goede zorg."
   ],
   "n": 2
  },
  {
   "lines": [
    "Oorlogsgeweld, vernietiging en plaag;",
    "ondanks dit al is Zions groei gestaag.",
    "Laat onze hoop in U verankerd zijn;",
    "Heer, dat uw goedheid immer op ons schijn’."
   ],
   "n": 3
  }
 ],

 "stanzas": [
  {
   "chorus": 0,
   "lines": [
    "Luister, o volk’ren! Hoor naar uw Heer,",
    "die weer gedenkt ’t verbond van weleer!",
    "Heilige eng’len hebben ’t gemeld:",
    "waarheid is weer hersteld!"
   ],
   "n": 1
  },
  {
   "chorus": 0,
   "lines": [
    "Zoekende volk’ren hebben geweend,",
    "biddend dat licht zou worden verleend.",
    "Nu is de donk’re nacht opgeklaard:",
    "waarheid is weer op aard’!"
   ],
   "n": 2
  },
  {
   "chorus": 0,
   "lines": [
    "Door God geroepen gaan w’ in zijn kracht",
    "naar elke natie, taal en geslacht;",
    "rusten niet uit tot elk heeft gehoord",
    "zijn heilig, reddend woord."
   ],
   "n": 3
  }
 ],

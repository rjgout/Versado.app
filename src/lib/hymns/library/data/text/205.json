 "stanzas": [
  {
   "lines": [
    "Als de rode ochtendzon",
    "opkomt aan de horizon,",
    "denk ik aan uw liefde zoet,",
    "die zovele wond’ren doet."
   ],
   "n": 1
  },
  {
   "lines": [
    "Vader, hoor mijn dankgebed,",
    "U, die daag’lijks op mij let.",
    "’k Weet dat U er altijd bent,",
    "als ik mij maar tot U wend."
   ],
   "n": 2
  }
 ],

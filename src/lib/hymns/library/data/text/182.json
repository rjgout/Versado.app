 "stanzas": [
  {
   "lines": [
    "Groot was de vreugd op ’t pinksterfeest,",
    "toen van Gods troon de Heil’ge Geest",
    "neerdaald’ en kroonde ieders hoofd",
    "met tongen vuurs, door Hem beloofd."
   ],
   "n": 1
  },
  {
   "lines": [
    "Zijn gaven, in dat uur gebracht,",
    "schonken tot overtuiging kracht;",
    "door ied’re ziel werd Godes woord",
    "aldaar in eigen taal gehoord."
   ],
   "n": 2
  },
  {
   "lines": [
    "Met macht bekleed uit hoger oord,",
    "brachten apost’len Jezus’ woord;",
    "leerden het schoon verlossingsplan,",
    "hetwelk een ieder redden kan."
   ],
   "n": 3
  },
  {
   "lines": [
    "Wie aan dat woord geloof wil slaan",
    "en wordt gedoopt in Jezus’ naam,",
    "krijgt dan vergeving van de zond’",
    "en vindt de redding in ’t ver bond."
   ],
   "n": 4
  }
 ],
 "subtitle": null,
 "tempoLabel": "Met overtuiging",
 "textCredit": "naar anonieme tekst, ca. 1850",
 "title": "Groot was de vreugd"
}

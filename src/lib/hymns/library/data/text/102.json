 "stanzas": [
  {
   "lines": [
    "Evenals de dauw des hemels zacht zich op het gras verspreidt,",
    "’t doet herleven, zo vervullend ’t doel van uw voorzienigheid."
   ],
   "n": 1
  },
  {
   "lines": [
    "Moge zo uw lering, Heiland, nederdalen op uw kerk,",
    "met uw zegen hier vervullen uw gebod, uw liefdewerk!"
   ],
   "n": 2
  },
  {
   "lines": [
    "Laat, terwijl wij hier aanbidden, dauw des levens, naar uw woord,",
    "nederdalen in ons midden uit uw heilig, hemels oord."
   ],
   "n": 3
  },
  {
   "lines": [
    "Wil ons smeken nu verhoren, vul de aarde met uw Geest;",
    "dat de volk’ren U aanbidden en eens ingaan tot uw feest!"
   ],
   "n": 4
  }
 ],
 "subtitle": null,
 "tempoLabel": "Gedragen",
 "textCredit": "naar Thomas Kelly (1769–1854)",
 "title": "Evenals de dauw des hemels"
}

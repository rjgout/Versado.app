 "stanzas": [
  {
   "lines": [
    "Kom, zing tot de Heer met dankbaarheid.",
    "Hij heeft in deze laatste tijd",
    "Zich weer geopenbaard",
    "en wond’ren als vanouds gedaan.",
    "Kom, zing tot de Heer en prijs zijn naam."
   ],
   "n": 1
  },
  {
   "lines": [
    "Profeten aanschouwden deze dag,",
    "zij maakten van zijn komst gewag",
    "in woord en jubellied;",
    "hij wordt in volheid nu onthuld.",
    "Kom, zing tot de Heer, van vreugd vervuld."
   ],
   "n": 2
  },
  {
   "lines": [
    "Het priesterschap is op aard’ hersteld,",
    "een sikkel voor het witte veld",
    "dat klaar is voor de oogst;",
    "de macht der rechtschapenheid ontvouwd.",
    "Kom, zing tot de Heer, ja, onverflauwd."
   ],
   "n": 3
  }
 ],
 "subtitle": null,
 "tempoLabel": "Vreugdevol",
 "textCredit": "naar Gerrit de Jong jr. (1892–1978)",
 "title": "Kom, zing tot de Heer"
}

 "stanzas": [
  {
   "lines": [
    "Heiland, geef een avondzegen",
    "eer de rust mijn ogen sluit.",
    "Ik belijd vol spijt mijn wegen,",
    "spreek vergeving op mij uit."
   ],
   "n": 1
  },
  {
   "lines": [
    "Als vernietiging bedreigt mij,",
    "pijlen vliegen om mij heen,",
    "is uw eng’lenwacht rondom mij,",
    "ik ben veilig dan alleen."
   ],
   "n": 2
  },
  {
   "lines": [
    "Zij de nacht ook bang en duister,",
    "hij verbergt mij voor U niet,",
    "Gij, die woont in pracht en luister",
    "en uw kind’ren nooit verliet."
   ],
   "n": 3
  },
  {
   "lines": [
    "Mocht de dood mij hier verrassen,",
    "vinden op deez’ legerstee,",
    "laat, van zonden rein gewassen,",
    "mij dan delen in uw vree."
   ],
   "n": 4
  }
 ],
 "subtitle": null,
 "tempoLabel": "Rustig",
 "textCredit": "anon.",
 "title": "Heiland, geef een avondzegen"
}

 "stanzas": [
  {
   "lines": [
    "Waarheid, woord uit hoger sfeer,",
    "toon uw volheid van weleer!",
    "Breek de ketens van de geest,",
    "lang in duisternis geweest."
   ],
   "n": 1
  },
  {
   "lines": [
    "Waarheid, weer op aard’ gebracht,",
    "smeed een koninklijk geslacht",
    "uit ’t verbondsvolk van de Heer,",
    "dat met Hem eens hier regeer’."
   ],
   "n": 2
  },
  {
   "lines": [
    "Waarheid gaat verwinnend voort",
    "tot elk mens haar heeft gehoord.",
    "Onveranderd door de tijd",
    "straalt haar licht in eeuwigheid."
   ],
   "n": 3
  }
 ],
 "subtitle": null,
 "tempoLabel": "Plechtig",
 "textCredit": "naar Parley P. Pratt (1807–1857)",
 "title": "Waarheid, woord uit hoger sfeer"
}

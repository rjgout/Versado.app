 "stanzas": [
  {
   "lines": [
    "O, hoor ons loflied, Heer,",
    "als bede U gebracht.",
    "Help ons uw heil’ge wil te doen",
    "en geef ons van uw kracht."
   ],
   "n": 1
  },
  {
   "lines": [
    "Houdt Gij ons hart in gloed",
    "met uw milddadig woord.",
    "Verleen uw Geest ons ieder uur",
    "en leid ons daag’lijks voort."
   ],
   "n": 2
  }
 ],

 "stanzas": [
  {
   "lines": [
    "Hoor, o heil’gen, richt uw schreden;",
    "kom in ’s Heren huis bijeen.",
    "Smeed tezamen dierb’re zielen",
    "uit het heden en ’t verleên."
   ],
   "n": 1
  },
  {
   "lines": [
    "Leer het plan van zaligmaking",
    "en gehoorzaam elk gebod.",
    "Eer uw eeuw’ge heilsverbonden",
    "met de Allerhoogste God."
   ],
   "n": 2
  },
  {
   "lines": [
    "Elohim, Gij groot Ontwerper,",
    "zend des hemels zegen neer",
    "op uw trouwe zoons en dochters",
    "in de tempels van hun Heer."
   ],
   "n": 3
  }
 ],

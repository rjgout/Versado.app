 "stanzas": [
  {
   "chorus": 0,
   "lines": [
    "Wees verheugd, de God van Isr’el",
    "wordt opnieuw gehoord;",
    "’t blijde nieuws klinkt uit de hemel,",
    "luister naar zijn woord.",
    "Waarheid springt uit d’aarde voort,",
    "spreidt haar licht naar ieder oord."
   ],
   "n": 1
  },
  {
   "chorus": 0,
   "lines": [
    "Eng’len keren met hun tijding",
    "tot de aarde weer",
    "en verlenen heil’ge sleutels,",
    "machten van weleer.",
    "Dat een ieder horen mag",
    "dit herstel van Gods gezag."
   ],
   "n": 2
  },
  {
   "chorus": 0,
   "lines": [
    "Groot is Christus, onze Koning,",
    "wonderbaar zijn werk,",
    "geeft ons hoop op zaligmaking,",
    "sticht opnieuw zijn kerk.",
    "Juich verheugd, de Vredevorst",
    "lest voor eeuwig onze dorst."
   ],
   "n": 3
  }
 ],

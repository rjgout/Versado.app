 "stanzas": [
  {
   "lines": [
    "Hij is uit de dood verrezen!",
    "Spreid het woord met grote vreugd.",
    "Op de derde dag herrezen;",
    "dat heel d’ aarde zij verheugd.",
    "Dood verwonnen, ’t mensdom vrij;",
    "Christus stierf voor u en mij."
   ],
   "n": 1
  },
  {
   "lines": [
    "Kom met heil’ge lofgezangen;",
    "zing de Heer een vreugdelied.",
    "Nee, geen enk’le wolk blijft hangen",
    "voor het gloren dat Hij biedt,",
    "dagend aan de purp’ren oost,",
    "’t paasfeest dat een ieder troost."
   ],
   "n": 2
  },
  {
   "lines": [
    "Hij is uit de dood verrezen,",
    "heeft geopend ’s hemels poort,",
    "dat een ieder vrij zou wezen,",
    "waardig zijn een hoger oord.",
    "Eens aanschouwt ons oog verblijd",
    "’t ware paaslicht ons bereid."
   ],
   "n": 3
  }
 ],
 "subtitle": null,
 "tempoLabel": "Gedragen",
 "textCredit": "naar Cecil Frances Alexander (1818–1895)",
 "title": "Hij is uit de dood verrezen!"
}

 "stanzas": [
  {
   "lines": [
    "Glorie zij God de Heer!",
    "Dat ieder Hem vereer!",
    "O, prijs zijn naam!",
    "Zijn liefd’ heeft ons bereid",
    "eeuwige zaligheid.",
    "Zing dankbaar en verblijd:",
    "Waardig is ’t Lam!"
   ],
   "n": 1
  },
  {
   "lines": [
    "Jezus, die voor ons stierf,",
    "’t leven voor ons verwierf;",
    "o, prijs zijn naam!",
    "Zeg wat voor ons Hij wrocht,",
    "hoe duur Hij ons eens kocht,",
    "ons heil steeds heeft gezocht.",
    "Waardig is ’t Lam!"
   ],
   "n": 2
  },
  {
   "lines": [
    "Dat uit der eng’len rang",
    "weergalm’ een vreugdezang.",
    "O, prijs zijn naam!",
    "God heeft voor Hem bereid",
    "lof, eer en majesteit",
    "door alle eeuwigheid.",
    "Waardig is ’t Lam!"
   ],
   "n": 3
  }
 ],
 "subtitle": null,
 "tempoLabel": "Blij",
 "textCredit": "naar James Allen (1734–1804)",
 "title": "Glorie zij God de Heer"
}

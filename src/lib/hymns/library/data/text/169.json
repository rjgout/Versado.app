 "stanzas": [
  {
   "chorus": 0,
   "lines": [
    "De wereld vraagt naar willig volk,",
    "naar werkers, waar en trouw.",
    "Wees kloek en sterk",
    "in ’t goede werk;",
    "steek uw handen uit de mouw."
   ],
   "n": 1
  },
  {
   "chorus": 0,
   "lines": [
    "Naar willig volk vraagt ook de kerk,",
    "naar zielen, hou en trouw.",
    "Met al uw macht",
    "uw taak volbracht;",
    "steek uw handen uit de mouw."
   ],
   "n": 2
  },
  {
   "chorus": 0,
   "lines": [
    "De strijd met zond’ en wee is zwaar,",
    "talm niet! Het luistert nauw.",
    "Die strijd duurt lang,",
    "maar wees niet bang;",
    "steek uw handen uit de mouw."
   ],
   "n": 3
  },
  {
   "chorus": 0,
   "lines": [
    "Werk dan en waak en strijd en bid,",
    "o, wees niet langer lauw!",
    "Steun, kloek en sterk,",
    "elk waardig werk;",
    "steek uw handen uit de mouw."
   ],
   "n": 4
  }
 ],

 "stanzas": [
  {
   "lines": [
    "Huiv’ring wekt dit woord des Heren:",
    "weest gij volmaakt!",
    "Maar met God mag men ’t proberen:",
    "weest gij volmaakt!",
    "’t Volgzaam kind, gelovig dader,",
    "kan eens worden als zijn Vader:",
    "weest gij volmaakt!",
    "Weest gij volmaakt!"
   ],
   "n": 1
  },
  {
   "lines": [
    "’t Klonk tot helden uit de Schriften:",
    "weest gij volmaakt!",
    "die het diep in ’t harte griften:",
    "weest gij volmaakt!",
    "Al beloonde God hun streven,",
    "eens zou Hij iets beters geven:",
    "weest gij volmaakt!",
    "Weest gij volmaakt!"
   ],
   "n": 2
  },
  {
   "lines": [
    "Ons is ’t beet’re nu geschonken:",
    "weest gij volmaakt!",
    "Schalm wordt weer aan schalm geklonken:",
    "weest gij volmaakt!",
    "Zonder die volkomen keten",
    "wordt geen volheid toegemeten:",
    "weest gij volmaakt!",
    "Weest gij volmaakt!"
   ],
   "n": 3
  },
  {
   "lines": [
    "Werkt dan voor en met de doden:",
    "weest gij volmaakt!",
    "Werkt met eng’len en met goden:",
    "weest gij volmaakt!",
    "Eeuw’ge schakels moet gij smeden,",
    "bindt het heden aan ’t verleden:",
    "weest gij volmaakt!",
    "Weest gij volmaakt!"
   ],
   "n": 4
  }
 ],
 "subtitle": null,
 "tempoLabel": "Met overtuiging",
 "textCredit": "Frank I. Kooyman (1880–1963)",
 "title": "Weest gij volmaakt!"
}

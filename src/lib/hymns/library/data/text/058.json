 "stanzas": [
  {
   "lines": [
    "Mooi zijn de sterren,",
    "mooier nog het licht der maan",
    "en de zon aan de hemelboog,",
    "maar ’t licht van Jezus",
    "straalt nog veel schoner",
    "en schenkt ons liefde van omhoog."
   ],
   "n": 1
  },
  {
   "lines": [
    "Mooi zijn de weiden,",
    "mooier nog de bossen",
    "en de lente in bloemenpracht.",
    "Jezus is mooier,",
    "Jezus is reiner,",
    "Hij maakt dat ’t droeve hart weer lacht."
   ],
   "n": 2
  },
  {
   "lines": [
    "Dierbare Heiland,",
    "Koning aller volken,",
    "Heer van ’t al en Godes Zoon,",
    "ere en glorie,",
    "lof en aanbidding",
    "zijn nu en voor altijd uw kroon."
   ],
   "n": 3
  }
 ],
 "subtitle": null,
 "tempoLabel": "Liefelijk",
 "textCredit": "naar Münster Gesangbuch, 1677",
 "title": "Dierbare Heiland"
}

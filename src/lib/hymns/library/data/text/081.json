 "stanzas": [
  {
   "lines": [
    "Uw liefde, Heer,",
    "schijnt als de zon met warme gloed",
    "van boven neer",
    "door wolken van conflict.",
    "Licht op ons pad,",
    "ze leidt ons naar uw overvloed;",
    "kostbare schat",
    "voor elk die tot U blikt."
   ],
   "n": 1
  },
  {
   "lines": [
    "Uw Geest, de stem",
    "van troost en rust, legt in ons hart",
    "een milde rem",
    "op ongeduld en nijd.",
    "Moge uw hand,",
    "die ons verkrampt gemoed ontwart,",
    "scheppen een band",
    "die blijft in eeuwigheid."
   ],
   "n": 2
  },
  {
   "lines": [
    "Vader en God,",
    "het offer, door uw Zoon gebracht,",
    "verheft ons lot",
    "tot eindeloze jeugd.",
    "Vreedzaam uw wet;",
    "uw last is licht, uw juk is zacht.",
    "Lam zonder smet,",
    "in U is onze vreugd."
   ],
   "n": 3
  }
 ],
 "subtitle": null,

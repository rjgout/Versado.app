 "stanzas": [
  {
   "lines": [
    "O grote Heer, wij bidden U, wil door uw Geest hier zijn,",
    "en maak ons hart bij ’t avondmaal ontvank’lijk, goed en rein."
   ],
   "n": 1
  },
  {
   "lines": [
    "Dat wij toch steeds indachtig zijn uw lijden, o zo bang,",
    "volbracht voor ons op Golgota, de liefde was uw drang."
   ],
   "n": 2
  },
  {
   "lines": [
    "Bereid ons oog om steeds te zien die rijkdom van genâ,",
    "die zaligheid, voor ons bereid, gewrocht op Golgota."
   ],
   "n": 3
  },
  {
   "lines": [
    "Laat ons hier steeds als broeders zijn, en, door uw Geest vereend,",
    "vergeven zoals Gij vergeeft, uw vreê wordt dan verleend."
   ],
   "n": 4
  }
 ],
 "subtitle": null,
 "tempoLabel": "Als een gebed",
 "textCredit": "naar Andrew Dalrymple, geb. 1817",
 "title": "O grote Heer"
}

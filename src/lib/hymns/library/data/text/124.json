 "stanzas": [
  {
   "lines": [
    "Aan ’t houten kruis op Golgota hing eenmaal onze Heer,",
    "verzegelde met zond’loos bloed zijn offer en zijn leer."
   ],
   "n": 1
  },
  {
   "lines": [
    "Aan ’t houten kruis stierf Hij voor ons en schonk de zekerheid",
    "dat door zijn dood ontsloten is de weg naar zaligheid."
   ],
   "n": 2
  },
  {
   "lines": [
    "Aan ’t houten kruis stierf onze God, maar, stervend, bracht Hij voort",
    "het wonder der verrijzenis, onz’ eeuw’ge nieuwgeboort’."
   ],
   "n": 3
  }
 ],

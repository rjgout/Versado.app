 "stanzas": [
  {
   "lines": [
    "Groot is de glorie van Zions blijde morgen,",
    "licht voor elk land dat in duisternis lag!",
    "Nu zwijgt de klaagtoon van droefheid en zorgen,",
    "Zion verkondigt een heuglijke dag."
   ],
   "n": 1
  },
  {
   "lines": [
    "Groot is de glorie van Zions blijde morgen,",
    "eeuwen door Isr’els profeten voorspeld.",
    "Nu worden ’s Heren verlosten geborgen,",
    "’t nieuws wordt aan Joden en and’ren gemeld."
   ],
   "n": 2
  },
  {
   "lines": [
    "In de woestijn, zie hoe bloemen welig bloeien,",
    "steppen en bergen, zij juichen verheugd.",
    "Zie hoe de waat’ren ontspringen en vloeien,",
    "hoor, hoe de wildernis jubelt van vreugd."
   ],
   "n": 3
  },
  {
   "lines": [
    "Hoor hoe uit alle werelddelen",
    "lof tot Jehovah ten hemel stijgt.",
    "Wonden van oorlog en smart zullen helen,",
    "niets dat de hemelse vrede bedreigt."
   ],
   "n": 4
  }
 ],
 "subtitle": null,
 "tempoLabel": "Blij",
 "textCredit": "naar Thomas Hastings (1784–1872)",
 "title": "Groot is de glorie van Zions blijde morgen"
}

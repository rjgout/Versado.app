 "stanzas": [
  {
   "lines": [
    "Zingen wij van Zion, koninkrijk van God.",
    "Zions volk is rein van hart,",
    "houdt zich van het kwaad apart.",
    "Zion, over d’aard’ verspreid, begroet eerlang haar God."
   ],
   "n": 1
  },
  {
   "lines": [
    "God zendt openbaring tot profeten neer.",
    "Waarheid is op aard’ hersteld;",
    "klaar voor d’oogst is nu het veld.",
    "Zion prepareert ons voor de terugkomst van de Heer."
   ],
   "n": 2
  },
  {
   "lines": [
    "Als de heil’gen Zions leven naar Gods wet",
    "zullen haat en strijd vergaan,",
    "enkel vreugd en rust bestaan.",
    "Eens wordt heel het rond der aard’ met Zions pracht bedekt."
   ],
   "n": 3
  }
 ],

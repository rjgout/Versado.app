 "stanzas": [
  {
   "lines": [
    "Dat ons bidden opwaarts rijze,",
    "God sta ons bij,",
    "opdat Hij ons gunst bewijze,",
    "God sta ons bij.",
    "Uit de hemel zij gegeven",
    "heil op aard’ in edel streven,",
    "God sta ons bij, God sta ons bij."
   ],
   "n": 1
  },
  {
   "lines": [
    "Lijkt het kwaad in macht verheven,",
    "God sta ons bij,",
    "wanhoop niet, want hoop doet leven,",
    "God sta ons bij.",
    "Falen wij, niets doet ons vrezen;",
    "ons verlies zal eervol wezen.",
    "God sta on bij, God sta ons bij."
   ],
   "n": 2
  },
  {
   "lines": [
    "Trouw, geduldig, nooit bezwijkend,",
    "God sta ons bij,",
    "noch voor leed of zonde wijkend,",
    "God sta ons bij;",
    "boven alles Hem beminnend",
    "en in ’s hemels tijd verwinnend,",
    "God sta ons bij, God sta ons bij."
   ],
   "n": 3
  }
 ],
 "subtitle": null,
 "tempoLabel": "Vastberaden",
 "textCredit": "naar William E. Hickson (1803–1870)",
 "title": "God sta ons bij"
}

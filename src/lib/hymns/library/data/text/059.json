 "stanzas": [
  {
   "lines": [
    "Vader, uw kind’ren verheffen nu",
    "dankbaar een vreugdegezang tot U",
    "voor uw bescherming en liefd’ en zorg;",
    "Gij zijt de heil’gen een steun en borg.",
    "Dankbaar voor uw evangelielicht,",
    "dat in de waarheid ons onderricht,",
    "blij dat wij kozen het beet’re deel,",
    "geven wij U, Heer, ons hart geheel."
   ],
   "n": 1
  },
  {
   "lines": [
    "Stijge dit lied tot uw troon omhoog;",
    "dat onze stem steeds U prijzen moog’!",
    "Leid ons zoals Gij getrouwen leidt,",
    "voed ons met kennis tot zaligheid.",
    "Laat ons niet dwalen van ’t pad der deugd,",
    "zie niet de dwaasheên van onze jeugd.",
    "Vader, ontvang nu ons vreugdelied",
    "dat U ons harte hier dankbaar biedt."
   ],
   "n": 2
  }
 ],

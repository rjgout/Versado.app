 "stanzas": [
  {
   "lines": [
    "Heil’gen, zie uw zegeningen",
    "uit Jehovahs milde hand.",
    "Zion wordt alom gevestigd",
    "in een grote broederband."
   ],
   "n": 1
  },
  {
   "lines": [
    "Uit het heden en ’t verleden",
    "wordt voor ’t laatst bijeenvergaard",
    "alle waarheid ooit verkondigd;",
    "volheid ongeëvenaard!"
   ],
   "n": 2
  },
  {
   "lines": [
    "Hef dan Zions vaandel opwaarts",
    "en getuig met luide stem",
    "dat de Vorst des hemels nadert;",
    "elke knie buigt eens voor Hem."
   ],
   "n": 3
  }
 ],

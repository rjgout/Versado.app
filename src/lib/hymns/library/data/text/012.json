 "stanzas": [
  {
   "lines": [
    "God van wijsheid, God van kracht,",
    "leid ons met uw grote macht.",
    "Smeed de ziel in vuur dat leeft,",
    "opdat Gij haar vorming geeft."
   ],
   "n": 1
  },
  {
   "lines": [
    "God van vrijheid, God van deugd,",
    "uw gebod is onze vreugd",
    "Maak ons tegen zonde sterk,",
    "dienstbaar in uw grote werk."
   ],
   "n": 2
  },
  {
   "lines": [
    "God van liefde, God van licht,",
    "immer zij ons oog gericht",
    "op uw eer en majesteit,",
    "op uw trouw en heiligheid."
   ],
   "n": 3
  }
 ],
 "subtitle": null,
 "tempoLabel": "Majestueus",

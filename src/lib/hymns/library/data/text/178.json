 "stanzas": [
  {
   "lines": [
    "Bij mijn studie van de Schriften,",
    "Vader, wilt Gij met mij zijn.",
    "Vul mijn hart met eed’le wijsheid,",
    "mijn verstand met kennis rein."
   ],
   "n": 1
  },
  {
   "lines": [
    "Bij mijn studie van de Schriften,",
    "wil mijn geest beroeren, Heer.",
    "Toon mij uw verborgenheden,",
    "hef mij naar een hoog’re sfeer."
   ],
   "n": 2
  },
  {
   "lines": [
    "Bij mijn studie van de Schriften,",
    "waarin ’k uw genade vond,",
    "wil mijn hart en ziel vertroosten,",
    "helen een verborgen wond."
   ],
   "n": 3
  },
  {
   "lines": [
    "Bij mijn studie van de Schriften,",
    "help mij overpeinzen, Heer.",
    "In uw woord is eeuwig leven,",
    "schenk uw licht mij immermeer."
   ],
   "n": 4
  }
 ],

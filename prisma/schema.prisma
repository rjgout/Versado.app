// De client wordt gegenereerd in src/generated/prisma (niet in git): na
// `npm install` of een schemawijziging eerst `npx prisma generate`.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// De verbindings-URL staat in prisma.config.ts (CLI) en src/lib/db.ts (app).
datasource db {
  provider = "postgresql"
}

// --- Accounts ---------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  // handle+discriminator vormen samen de unieke, doorzoekbare "tag"
  // (bv. "Jan#42") — bewust NIET uniek op zichzelf, zodat mensen niet
  // hun e-mailadres hoeven te delen om gevonden te worden. Zie
  // src/lib/handle.ts voor het genereren/parsen van deze tag.
  handle             String
  discriminator      String // 2 cijfers, bv. "04"
  // Standaard UIT: alleen als een gebruiker dit expliciet aanzet, kan diens
  // exacte e-mailadres gebruikt worden om ze te vinden bij het toevoegen
  // van vrienden (zie /api/users/search).
  searchableByEmail  Boolean   @default(false)
  passwordHash       String
  // Verhoogd bij een wachtwoordreset/-wijziging zodat alle eerder uitgegeven sessietokens direct ongeldig worden.
  sessionVersion     Int       @default(0)
  // Optionele TOTP-tweestapsverificatie; het geheime seed wordt versleuteld opgeslagen.
  totpEnabled          Boolean @default(false)
  totpSecretEncrypted  String?
  // JSON-array met bcrypt-hashes van eenmalige herstelcodes.
  totpRecoveryCodes    String?
  // De allereerste ECHTE registratie op een verse installatie wordt
  // automatisch admin (zie /api/auth/register); daarna kan een admin dit
  // bij andere gebruikers aan/uit zetten via /adminbackend.
  isAdmin            Boolean   @default(false)
  // Gezet door een admin-wachtwoordreset (/adminbackend); dwingt de
  // gebruiker om na inloggen eerst zelf een nieuw wachtwoord te kiezen
  // voordat de rest van de app bereikbaar is (zie dashboard/page.tsx).
  mustChangePassword Boolean   @default(false)
  // null = nog niet bevestigd. Wordt alleen afgedwongen (zie dashboard/page.tsx)
  // als er een werkende e-mailconfiguratie is (EmailSettings.enabled) — anders
  // zou niemand ooit voorbij de bevestigingspagina komen.
  emailVerifiedAt    DateTime?
  createdAt          DateTime  @default(now())
  // Bijgehouden door de socket.io-verbinding die elke ingelogde gebruiker al
  // op elke pagina open heeft staan (zie InviteListener.tsx en
  // src/server/gameServer.ts), niet alleen tijdens een live spel.
  // onlineSocketCount is het aantal open tabs/apparaten tegelijk (>0 = nu
  // online) — bewust in de database i.p.v. in-memory in gameServer.ts, want
  // een Next.js server component (zoals /adminbackend) draait via Next's
  // eigen bundel en deelt geen module-geheugen met het los uitgevoerde
  // server.ts. lastSeenAt is het moment van de laatste connect/disconnect,
  // voor "hoe lang geleden" op het adminoverzicht.
  onlineSocketCount  Int       @default(0)
  lastSeenAt         DateTime?
  // Vrienden-aanwezigheid (zie src/lib/presence.ts): allebei standaard UIT,
  // zelfde privacy-by-default-principe als searchableByEmail hierboven —
  // een bestaande of nieuwe gebruiker wordt nooit automatisch zichtbaar.
  // shareCurrentActivity is een sub-instelling die alleen iets betekent als
  // shareOnlineStatus ook aan staat (server-side afgedwongen, zie presence.ts
  // — niet alleen client-side verborgen). "Laatst actief X geleden" heeft
  // bewust geen eigen schakelaar: dat valt onder shareOnlineStatus, want het
  // is strikt minder onthullend dan een live groene stip.
  shareOnlineStatus    Boolean   @default(false)
  shareCurrentActivity Boolean   @default(false)
  // Tijdelijk "onzichtbaar voor vrienden" zonder de permanente instellingen
  // hierboven aan te raken — null = niet actief. Automatisch verlopen via
  // runIncognitoExpiryTick() in scheduler.ts (self-gating, net als de
  // andere ticks daar), of handmatig eerder uitgezet.
  invisibleUntil       DateTime?
  // Beste ooit behaalde positie op de Nederlandse ranglijst (zie
  // /api/leaderboard?scope=national) — opportunistisch bijgewerkt telkens als
  // die ranglijst voor deze gebruiker wordt berekend, zodat het profiel dit
  // kan tonen zonder elke keer de hele geschiedenis te herberekenen.
  bestNationalRank   Int?
  // null = deze gebruiker moet de onboarding-flow (/onboarding) nog zien —
  // zet dashboard/page.tsx dan een redirect in werking. Niet-null (gezet bij
  // overslaan én bij afronden, zie /api/onboarding/complete) betekent "niet
  // opnieuw automatisch tonen"; via een knop op het profiel kan de flow
  // alsnog handmatig herstart worden. Bestaande gebruikers krijgen dit bij de
  // migratie met terugwerkende kracht gevuld, zodat zij 'm nooit te zien
  // krijgen — alleen nieuwe registraties na deze wijziging doorlopen 'm.
  onboardingSeenAt   DateTime?
  // Zelfgerapporteerd tijdens de onboarding ("Hoeveel ken je het Boek van
  // Mormon al?") — bepaalt alleen de standaardvolgorde van cursussen/
  // spelletjes (zie UserListOrder hieronder), nooit een harde blokkade.
  // Null = nooit gevraagd (bestaande gebruikers vóór deze wijziging, of
  // iemand die de onboarding oversloeg vóór dit scherm bereikt werd) — dan
  // blijft de standaardvolgorde gewoon ongewijzigd.
  bomKnowledgeLevel  IntroKnowledgeLevel?
  // Persoonlijke gids (Novi, Varo of Vera) die de gebruiker door de app
  // begeleidt: gekozen bij de onboarding, te wijzigen op het profiel. De
  // app kiest de reactie (state), dit veld wie hem uitvoert; zie
  // src/lib/companion.ts. Bestaande accounts krijgen Novi, die al de
  // metgezel op de persoonlijke momenten was.
  companion          Companion @default(NOVI)

  quickMissionaryRuns QuickMissionaryRun[]
  mysteryProgress     MysteryProgress[]

  // De actieve contentcollectie voor de contentswitcher. Null betekent dat de gebruiker
  // nog geen expliciete keuze heeft gemaakt; de app gebruikt dan de standaardcollectie.
  activeContentCollectionId String?
  activeContentCollection   ContentCollection? @relation("ActiveContentCollection", fields: [activeContentCollectionId], references: [id], onDelete: SetNull)

  // Taal van de app (menu's, knoppen, meldingen, e-mails) en taal van de
  // content (welke uitgave van een werk je leest en speelt) staan bewust los
  // van elkaar: je kunt bv. de app in het Duits gebruiken en het Boek van
  // Mormon in het Nederlands lezen. Codes uit src/lib/languages.ts.
  uiLanguage      String @default("nl")
  contentLanguage String @default("nl")

  // Eigen emoji voor het avatar-rondje (zie ProfileClient.tsx — klik op het
  // rondje op je profielpagina om 'm te zetten), los van de gebruikersnaam:
  // een naam die met een emoji begint, wordt daar bewust NIET automatisch
  // voor gebruikt. Null = toon de eerste letter van de gebruikersnaam
  // i.p.v. een emoji (het gedrag van vóór deze kolom, dus geen backfill nodig).
  avatarEmoji        String?

  // Persoonlijke uitnodigingslink (/uitnodiging/<code>, zie
  // src/lib/friendInvite.ts): wie via die link een account maakt of op
  // "Word vrienden" tikt, is meteen bevriend. Pas aangemaakt als iemand de
  // link voor het eerst opvraagt; "Nieuwe link maken" vervangt 'm, waarmee de
  // oude ongeldig wordt. Null = nog nooit opgevraagd, dus geen backfill nodig.
  inviteCode         String?   @unique
  // Account aangemaakt via iemands uitnodigingslink (en daardoor bevriend).
  // Alleen voor de teller in /adminbackend; bewust geen verwijzing naar de
  // uitnodiger, zodat de telling niet zakt als die zijn account verwijdert.
  // Accounts van vóór deze kolom: false, want dat is niet meer te herleiden.
  registeredViaInvite Boolean  @default(false)

  // Changelog ("Wat is er nieuw?", zie /adminbackend en het profiel): staat
  // standaard AAN maar is door de gebruiker zelf uit/aan te zetten op het
  // profiel — staat 'm uit, dan verschijnt de pop-up bij het inloggen (zie
  // ChangelogPopup.tsx) nooit, maar de lijst blijft daar altijd handmatig
  // terug te vinden. changelogSeenAt bepaalt wat "nieuw" is (elk item met een
  // latere createdAt); @default(now()) zorgt dat een gloednieuwe registratie
  // de bestaande geschiedenis niet meteen als nieuw te zien krijgt (zelfde
  // motivatie als onboardingSeenAt hierboven). Bestaande gebruikers krijgen
  // deze kolom bij de migratie gevuld met het moment van migreren (via de
  // kolom-default zelf, zie migration.sql) — ook zij dus geen plotselinge
  // stapel "nieuw" bij het uitrollen van deze feature.
  changelogEnabled Boolean  @default(true)
  changelogSeenAt  DateTime @default(now())

  // Countdown naar de Algemene Conferentie op Vandaag (zie
  // src/lib/generalConference.ts). Standaard aan, ook voor bestaande
  // accounts; uit te zetten op het profiel.
  conferenceCountdownEnabled Boolean @default(true)

  // xpTotal/currentStreak/freezeCount zijn caches voor snelle reads (dashboard,
  // nav-badges). De bron van waarheid voor XP is XPTransaction; voor freezes
  // is dat FreezeTransaction. Zie src/lib/xp.ts en src/lib/streak.ts.
  xpTotal       Int     @default(0)
  currentStreak Int     @default(0)
  longestStreak Int     @default(0)
  lastStudyDate String? // yyyy-mm-dd, kalenderdag in lastStudyTimeZone
  freezeCount   Int     @default(0)
  // Tijdzones (zie src/lib/timeZone.ts en docs/TIJD.md). timeZone is de
  // IANA-tijdzone die de browser het laatst doorgaf; null = nog onbekend,
  // dan geldt Europe/Amsterdam. lastStudyTimeZone is de tijdzone waarin
  // lastStudyDate is behaald; null = van vóór de tijdzones, toen elke
  // reeksdag een UTC-dag was. Bewust zonder backfill: zo blijven bestaande
  // reeksen precies zoals ze waren.
  timeZone          String?
  lastStudyTimeZone String?
  // Uitrolgrens: historische gaten vóór deze dag veranderen geen bestaande reeks.
  streakGraceDay String?
  // Eerste onbevroren gemiste dag; null = actief. Het opgebouwde getal blijft staan.
  streakInterruptedDay String?
  streakReturnDay String?
  streakReturnTimeZone String?
  streakReturnCount Int @default(0)
  streakReturnRequired Int @default(0)
  // App opnieuw gebruikt: stopt herinneringen voor deze onderbreking, geen reekscredit.
  streakReturnSeenAt DateTime?
  streakReminderDay Int @default(0)
  streakActivities StreakActivity[]
  // Het enige hint-tegoed dat er is (zie src/lib/shop.ts) — gekocht in de
  // winkel of verdiend bij het Woordspel/Raad het hoofdstuk komt allebei
  // hier terecht, zodat overal waar hints gebruikt kunnen worden precies
  // hetzelfde getal te zien is. Eerder bestonden er ook losse per-partij
  // tegoeden (ScrabbleGame.player1/2HintCredits, ChapterGuessGame.hintCredits)
  // die pas bij uitputting dit tegoed aanspraken — dat gaf per scherm een
  // ander getal te zien, dus vervangen door dit ene gedeelde tegoed.
  hintBalance   Int     @default(0)

  // Niet meer gebruikt: de badge van de webapp is nu het aantal meldingen in
  // het meldingencentrum (Notification). Blijft staan om geen data te laten vallen.
  notificationBadgeCount Int @default(0)

  // Notificaties: allebei standaard UIT (zelfde privacy-by-default-principe
  // als searchableByEmail hierboven) — een gebruiker moet er zelf voor
  // kiezen. Pushnotificaties vereisen daarnaast browsertoestemming (zie
  // PushSubscription); e-mailnotificaties vereisen dat de admin SMTP heeft
  // ingesteld (zie EmailSettings/isEmailConfigured). Dit zijn de kanaal-
  // schakelaars (moet minstens één aan staan); per-categorie verfijning
  // (welke gebeurtenissen) staat hieronder bij notify*.
  emailNotificationsEnabled    Boolean @default(false)
  pushNotificationsEnabled     Boolean @default(false)
  // "HH:MM", geïnterpreteerd in de lokale tijd van de server/container (er
  // is nergens in deze app een per-gebruiker tijdzone bijgehouden — zie
  // dayKey() in src/lib/dates.ts die ook al bewust op UTC-dagbuckets werkt).
  dailyReminderTime            String  @default("20:00")
  dailyTextTime                String  @default("09:00")
  notifyDailyText              Boolean @default(false)
  // Voorkomen dat de in-process scheduler (zie src/lib/scheduler.ts) dezelfde
  // dag/week twee keer een herinnering/uitslag stuurt.
  lastDailyReminderSentDate    String?
  lastDailyTextSentDate        String?
  lastWeeklyResultNotifiedWeek String?
  // Nieuw woord van de dag beschikbaar (zie src/lib/wordGame.ts) — apart
  // bijgehouden omdat dit op een vast Nederlands tijdstip (18:00) gaat,
  // los van dailyReminderTime.
  lastWordGameNotifiedDate     String?

  // Per-categorie voorkeur (i.p.v. alles-of-niets): standaard AAN zodra een
  // kanaal hierboven aan staat — dit is dus een manier om juist categorieën
  // uit te zetten, geen tweede opt-in-drempel. Zie notifyUser in
  // src/lib/notify.ts voor hoe dit samen met de kanaalschakelaars werkt.
  notifyDailyReminder Boolean @default(true)
  notifyStreakReturn  Boolean @default(true)
  notifySocial        Boolean @default(true) // vriendschapsverzoeken, uitdagingen, woordspel
  notifyActivityReactions Boolean @default(true) // samengevatte reacties op eigen activiteiten
  notifyAchievements  Boolean @default(true) // prestaties, wekelijkse competitie-uitslag
  notifyWordGame      Boolean @default(true) // nieuw woord van de dag
  // Melding in de app als een vriend online komt (zie announceCameOnline in
  // src/lib/presence.ts); nooit als push of e-mail.
  notifyFriendOnline  Boolean @default(true)

  pushSubscriptions  PushSubscription[]
  notifications      Notification[]
  challengesSent     Challenge[]        @relation("ChallengeSender")
  challengesReceived Challenge[]        @relation("ChallengeReceiver")

  scrabbleGamesAsPlayer1 ScrabbleGame[] @relation("ScrabblePlayer1")
  scrabbleGamesAsPlayer2 ScrabbleGame[] @relation("ScrabblePlayer2")
  scrabbleMoves          ScrabbleMove[]

  progress        ChapterProgress[]
  contentProgress ContentProgress[]
  exerciseCredits ContentExerciseCredit[]
  exerciseSessions ExerciseSession[]
  readingSessions ReadingSession[]
  attempts        ExerciseAttempt[]
  freezeTx        FreezeTransaction[] @relation("FreezeOwner")
  freezeTxRelated FreezeTransaction[] @relation("FreezeRelated")
  xpTx            XPTransaction[]
  activityFeedItems ActivityFeedItem[]
  activityFeedReactions ActivityFeedReaction[]
  activityReactionNotificationBatches ActivityReactionNotificationBatch[] @relation("ActivityReactionNotificationRecipient")
  weeklyScores    WeeklyScore[]
  bookmarks       Bookmark[]
  highlights      Highlight[]
  notes           Note[]
  achievements    UserAchievement[]

  sentFriendReqs     Friendship[] @relation("FriendSender")
  receivedFriendReqs Friendship[] @relation("FriendReceiver")

  hostedGames LiveGame[]       @relation("GameHost")
  gamePlayers LiveGamePlayer[]
  gameInvites LiveGameInvite[]
  studyAnswers StudyAnswer[]
  alleskennerSeen AlleskennerSeen[]
  alleskennerSeasonsHosted AlleskennerSeason[]       @relation("AlleskennerSeasonHost")
  alleskennerSeasonsDeputy AlleskennerSeason[]       @relation("AlleskennerSeasonDeputy")
  alleskennerSeasonsWon    AlleskennerSeason[]       @relation("AlleskennerSeasonChampion")
  alleskennerSeasonMembers AlleskennerSeasonMember[]
  alleskennerSoloRuns      AlleskennerSoloRun[]

  chapterGuessGames ChapterGuessGame[]
  wordGames         WordGame[]
  wordSearchGames   WordSearchGame[]

  authTokens AuthToken[]

  // De cursus die momenteel "Vandaag" op het dashboard bepaalt. Losse
  // voortgang per cursus blijft bewaard in UserCourseProgress, dus
  // wisselen van cursus verlies je nooit je plek in een andere.
  activeCourseId String?
  activeCourse   Course?              @relation("ActiveCourse", fields: [activeCourseId], references: [id], onDelete: SetNull)
  courseProgress UserCourseProgress[]
  courseLessonProgress UserCourseLessonProgress[]

  podcastAttempts        PodcastExerciseAttempt[]
  podcastProgress        PodcastEpisodeProgress[]
  podcastPlaybackHistory PodcastPlaybackProgress[]
  kidsAttempts           KidsExerciseAttempt[]
  kidsProgress           KidsStoryProgress[]
  introAttempts          IntroExerciseAttempt[]
  introProgress          IntroLessonProgress[]
  listOrders             UserListOrder[]

  feedbackReports     Feedback[]
  streakDays          StreakDay[]

  // Samen: vriendenreeksen, groepen en seintjes (zie src/lib/social/ en
  // docs/SAMEN.md). Seintjes van vrienden staan standaard aan, ook voor
  // bestaande accounts: zonder vrienden kan niemand je er een sturen.
  nudgesEnabled        Boolean            @default(true)
  friendStreaksA       FriendStreak[]     @relation("FriendStreakA")
  friendStreaksB       FriendStreak[]     @relation("FriendStreakB")
  friendStreaksInvited FriendStreak[]     @relation("FriendStreakInviter")
  groupMemberships     GroupMembership[]
  groupInvitesReceived GroupInvite[]      @relation("GroupInvitee")
  groupInvitesSent     GroupInvite[]      @relation("GroupInviter")
  groupFreezeOffers    GroupFreezeOffer[]
  groupJoinRequests    GroupJoinRequest[] @relation("GroupJoinRequester")
  groupJoinDecisions   GroupJoinRequest[] @relation("GroupJoinDecider")
  nudgesSent           Nudge[]            @relation("NudgeSender")
  nudgesReceived       Nudge[]            @relation("NudgeRecipient")
  seasonResults       SeasonResult[]
  competitionXpEvents CompetitionXpEvent[]

  @@unique([handle, discriminator])
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Eenmalige, verlopende tokens voor e-mailbevestiging en wachtwoordreset.
// Er wordt alleen een sha256-hash van het token opgeslagen — de ruwe waarde
// staat alleen (kortstondig) in de link in de e-mail zelf. Zie src/lib/authTokens.ts.
// Een registratie die nog op e-mailbevestiging wacht. Pas bij het klikken op
// de link wordt hier een User van gemaakt (src/lib/registration.ts): zo
// bestaat er vóór bevestiging geen account, geen naam en nummer, geen
// vriendschap uit een uitnodiging en geen melding aan wie uitnodigde. Een
// nieuwe registratie met hetzelfde adres vervangt deze rij, zodat niemand
// andermans adres bezet kan houden. Na bevestiging blijft de rij nog even
// staan (confirmedAt), zodat een tweede klik op dezelfde link "al bevestigd"
// toont in plaats van "ongeldig" (mailscanners openen links soms als eerste).
model PendingRegistration {
  id              String    @id @default(cuid())
  email           String    @unique
  handle          String
  passwordHash    String
  uiLanguage      String    @default("nl")
  contentLanguage String    @default("nl")
  inviteCode      String?
  // Waar iemand na bevestiging heen wil (bv. een groepslink), alleen een pad binnen de app.
  returnTo        String?
  tokenHash       String    @unique
  expiresAt       DateTime
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([expiresAt])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

// Eén (singleton, id="singleton") rij met de uitgaande-mail-configuratie,
// beheerd door een admin via /adminbackend — bewust GEEN env-var-only opzet,
// zodat dit zonder herdeployen aan te passen is. Kan elke SMTP-dienst zijn
// (Microsoft 365, Gmail-app-wachtwoord, een eigen mailserver, ...).
model EmailSettings {
  id              String   @id @default("singleton")
  enabled         Boolean  @default(false)
  smtpHost        String?
  smtpPort        Int      @default(587)
  smtpSecure      Boolean  @default(false) // true = impliciete TLS (poort 465), false = STARTTLS (587)
  smtpUsername    String?
  // AES-256-GCM-versleuteld met een sleutel afgeleid van SESSION_SECRET (zie
  // src/lib/crypto.ts) — nooit als platte tekst opgeslagen.
  smtpPasswordEnc String?
  fromEmail       String?
  fromName        String?
  updatedAt       DateTime @updatedAt
}

// Eén (singleton) rij die het laatst geziene publieke adres onthoudt waarmee
// iemand de app heeft bezocht (zie getBaseUrl/getAppUrl in src/lib/baseUrl.ts).
// Nodig omdat achtergrondprocessen zonder eigen HTTP-request — de
// notificatie-schedulers en de socket.io-spelserver, zie src/lib/notify.ts —
// anders geen manier hebben om te weten via welk domein deze self-hosted app
// bereikbaar is, en zonder deze cache zou een e-maillink dan op localhost
// uitkomen. Wordt automatisch bijgewerkt bij elk binnenkomend verzoek, dus
// zonder handmatige configuratie (APP_URL blijft een expliciete override).
model DetectedAppUrl {
  id        String   @id @default("singleton")
  url       String
  updatedAt DateTime @updatedAt
}

// --- Content: boek/hoofdstuk/vers-structuur -----------------------------
//
// Bewust generiek, niet gebonden aan één specifiek schriftwerk: Book is een
// willekeurig boek binnen een cursus/schriftwerk, niet per se "een boek van
// het Boek van Mormon". De huidige content (zie prisma/content.ts,
// prisma/bomContent.json en prisma/importContent.ts) komt uitsluitend uit
// het Boek van Mormon, maar een toekomstig schriftwerk (bv. de Leer en
// Verbonden) kan met dezelfde Book/Chapter/Verse-modellen en dezelfde
// import/Course-machinerie (zie src/lib/courses.ts) toegevoegd worden,
// zonder schemawijziging hier. Zie het commentaar bij syncCourses() in
// src/lib/courses.ts voor de ene plek die dan wél aangepast moet worden
// (de "van voor naar achter"/"vrije keuze"-cursussen spannen nu bewust over
// alle Book-rijen heen, wat pas fout wordt zodra er een tweede schriftwerk
// bijkomt).

model Book {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  order    Int
  // Taalonafhankelijke sleutel van het boek: het pad dat de kerk zelf
  // gebruikt ("bofm/alma", "dc-testament/dc", "pgp/moses"). Een vers in een
  // andere taal is hetzelfde vers als Book.key, hoofdstuk- en versnummer
  // gelijk zijn; zo kunnen spelers in verschillende talen samen spelen.
  // Null bij content zonder vaste bron (bv. een eigen import).
  key      String?
  chapters Chapter[]
  courses  Course[] // BY_BOOK-cursussen die dit boek dekken
  contentCollectionId String
  contentCollection   ContentCollection @relation(fields: [contentCollectionId], references: [id], onDelete: Cascade)

  @@unique([contentCollectionId, key])
}

model Chapter {
  id                   String               @id @default(cuid())
  bookId               String
  book                 Book                 @relation(fields: [bookId], references: [id], onDelete: Cascade)
  number               Int
  order                Int
  // De officiële hoofdstukkop (samenvatting + jaartal, bv. "Ongeveer 600
  // v.C.") die boven het hoofdstuk staat — apart van de verzen zelf, en
  // gebruikt als introtekst bij "Raad het hoofdstuk" (zie
  // src/lib/chapterGuess.ts). Optioneel omdat niet elke seed-bron 'm heeft.
  heading              String?
  // Voorgelezen hoofdstuk (audio van de kerk in de taal van de uitgave, per
  // hoofdstuk één bestand; zie prisma/bomAudio*.json en prisma/importAudio.ts). Null = geen
  // audio, dan leest de computerstem voor. audioHeadingStart/End omsluiten de
  // voorgelezen hoofdstukkop, zónder "Hoofdstuk N" ervoor (dat zou bij
  // "Raad het hoofdstuk" het antwoord verklappen).
  audioUrl             String?
  audioHeadingStart    Float?
  audioHeadingEnd      Float?
  verses               Verse[]
  exercises            Exercise[]
  progress             ChapterProgress[]
  liveGames            LiveGame[]
  readingSessions      ReadingSession[]
  exerciseSessions     ExerciseSession[]
  courseChapters       CourseChapter[]
  courseLessons        CourseLesson[]
  courseProgressCursor UserCourseProgress[]
  challenges           Challenge[]

  @@unique([bookId, number])
}

// --- Contentcollecties ------------------------------------------------------
// Een collectie is het hoogste contentniveau voor de contentswitcher (bv. het
// Boek van Mormon, Leer en Verbonden of een later eigen lesboek). Book blijft
// de bestaande onderliggende boek/hoofdstukstructuur; de collectie bepaalt
// welke cursussen en spellen in de app-context beschikbaar zijn.
model ContentCollection {
  id        String   @id
  slug      String   @unique
  name      String
  icon      String
  order     Int      @default(0)
  // Interne vlag: de seed en syncCourses kiezen hiermee de standaardcollectie.
  // Wat gewone gebruikers in het contentmenu zien, is bewust een apart veld,
  // zodat een collectie verbergen nooit de cursusopbouw verandert.
  enabled   Boolean  @default(true)
  // Beheerders zien altijd alle collecties, zodat ze nieuwe content kunnen
  // bekijken voordat die voor iedereen beschikbaar is.
  visibleToUsers Boolean @default(true)
  // Welk werk dit is, los van de taal (kerk-URI-deel: "bofm",
  // "dc-testament", "pgp"; eigen content: "fsy", "podcasts"). Samen met
  // language vormt dit één uitgave; dezelfde verzen in een andere taal
  // vind je via hetzelfde werk en dezelfde Book.key.
  work      String?
  language  String   @default("nl")
  books     Book[]
  courses   Course[]
  gameScopes GameContentScope[]
  users     User[]   @relation("ActiveContentCollection")
  fsyLessons FsyLesson[]
  persons   Person[]
  wordSearchGames WordSearchGame[]
}

// Koppelt een spel aan één of meer contentcollecties. gameKey is de stabiele
// sleutel uit de spelcatalogus in LiveLobbyForm.tsx; daardoor hoeft de
// spelcatalogus niet naar de database te verhuizen.
model GameContentScope {
  id                   String           @id @default(cuid())
  gameKey              String
  contentCollectionId  String
  contentCollection    ContentCollection @relation(fields: [contentCollectionId], references: [id], onDelete: Cascade)

  @@unique([gameKey, contentCollectionId])
  @@index([contentCollectionId])
}

// Singleton: bepaalt alleen of de contentswitcher voor gewone gebruikers
// zichtbaar is. De inhoud zelf komt uit ContentCollection.
model ContentSwitcherSettings {
  id      String  @id @default("singleton")
  enabled Boolean @default(false)
}

// Singleton voor de automatische FSY-broncontrole. Nieuwe inhoud komt eerst
// als concept binnen; pas na controle wordt de gepubliceerde versie vervangen.
// Met autoPublish kan dit later bewust worden omgezet naar directe publicatie.
model FsySettings {
  id            String   @id @default("singleton")
  autoPublish   Boolean  @default(false)
  lastCheckedAt DateTime?
  lastError     String?
  updatedAt     DateTime @updatedAt
}

// --- Cursussen: verschillende manieren om door de content te lopen --------
//
// FRONT_TO_BACK en BY_BOOK hebben een vaste, geordende hoofdstuklijst
// (CourseChapter) die opnieuw wordt opgebouwd bij elke content-import (zie
// prisma/importContent.ts) — dus altijd in sync met de actuele inhoud.
// FREE_CHOICE heeft bewust GEEN CourseChapter-rijen: dat is de vrije "kies
// zelf een hoofdstuk"-modus over alle content heen, zonder vaste volgorde.
enum CourseType {
  FRONT_TO_BACK
  READING_LESSONS
  FREE_CHOICE
  BY_BOOK
  // Singleton (net als FREE_CHOICE): geen CourseChapter-rijen, alle
  // PodcastEpisode-rijen horen er impliciet bij. Zie src/lib/courses.ts.
  PODCAST
  // Singleton, net als PODCAST: alle KidsStory-rijen horen er impliciet bij.
  KIDS
  // Singleton, net als PODCAST/KIDS: alle IntroLesson-rijen horen er
  // impliciet bij ("Ontdek het Boek van Mormon", de introductiecursus voor
  // wie nog geen voorkennis heeft).
  INTRO
  // Singleton binnen de FSY-contentcollectie: de wekelijkse lessen staan
  // in FsyLesson en hebben bewust geen Chapter/Verse-structuur.
  FSY
}

model Course {
  id          String     @id @default(cuid())
  slug        String     @unique
  type        CourseType
  name        String
  description String?
  order       Int        @default(0)
  bookId      String? // alleen gezet voor BY_BOOK
  book        Book?      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  contentCollectionId String
  contentCollection   ContentCollection @relation(fields: [contentCollectionId], references: [id], onDelete: Cascade)
  podcastId   String? // alleen gezet voor PODCAST
  podcast     Podcast?   @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  // Door een admin uit te zetten via /adminbackend — verdwijnt dan uit ieders
  // cursussenoverzicht/toevoeg-catalogus (zie /api/courses en
  // /api/courses/catalog), maar bestaande voortgang blijft gewoon bestaan en
  // een rechtstreekse link blijft werken (bewust geen harde blokkade).
  enabled     Boolean    @default(true)
  kidsStories KidsStory[]

  chapters       CourseChapter[]
  userProgress   UserCourseProgress[]
  activeForUsers User[]               @relation("ActiveCourse")
  lessons        CourseLesson[]
  studySessions  StudySession[]
}

model CourseChapter {
  id        String  @id @default(cuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order     Int

  @@unique([courseId, chapterId])
  @@unique([courseId, order])
  @@index([chapterId])
}

// Kleine leeslessen binnen een cursus. De grenzen worden één keer bepaald
// op basis van het aantal verzen en blijven daarna vaststaan, zodat de route
// door het boek voor alle gebruikers hetzelfde is.
model CourseLesson {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order     Int
  startVerse Int
  endVerse   Int

  exercises CourseLessonExercise[]
  progress  UserCourseLessonProgress[]
  exerciseSessions ExerciseSession[]
  currentForCourseProgress UserCourseProgress[] @relation("CurrentCourseLesson")

  @@unique([courseId, order])
  @@unique([courseId, chapterId, startVerse])
  @@index([courseId, chapterId])
  @@index([chapterId])
}

// Koppelt de vaste 2-3 vragen aan een leesles. De vragen komen uit de
// bestaande, gecontroleerde oefenbank van de bijbehorende verzen.
model CourseLessonExercise {
  id        String       @id @default(cuid())
  lessonId  String
  lesson    CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise  Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order     Int

  @@unique([lessonId, exerciseId])
  @@unique([lessonId, order])
  @@index([exerciseId])
}

// Voortgang per gebruiker en per kleine leesles. Anders dan ChapterProgress
// is dit bewust gekoppeld aan deze cursus, zodat de gewone hoofdstuklessen
// ongemoeid blijven.
model UserCourseLessonProgress {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean     @default(false)
  bestScore   Int         @default(0)
  xpEarned    Int         @default(0)
  completedAt DateTime?

  @@unique([userId, lessonId])
  @@index([userId, completedAt])
}

// Per gebruiker, per cursus: welk hoofdstuk als volgende aan de beurt is.
// Blijft bestaan als je naar een andere cursus wisselt, zodat je nooit je
// plek kwijtraakt (zie User.activeCourseId hierboven).
model UserCourseProgress {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  currentChapterId String? // Bestaande cursussen gebruiken dit als huidige hoofdstuk.
  currentChapter   Chapter? @relation(fields: [currentChapterId], references: [id], onDelete: SetNull)
  currentLessonId  String? // De kleine leeslessen gebruiken dit als volgende les.
  currentLesson    CourseLesson? @relation("CurrentCourseLesson", fields: [currentLessonId], references: [id], onDelete: SetNull)
  comboCount       Int      @default(0)
  comboLastCompletedAt DateTime?
  lastActivityAt   DateTime @default(now())
  // Staat deze cursus in de persoonlijke cursussenlijst ("Cursussen")? Een
  // gebruiker kan een cursus verwijderen (dit op false zetten, zie
  // subscribeUserToCourse/unsubscribe-route in src/lib/courses.ts) zonder de
  // rest van deze rij (currentChapterId, dus de voortgang) kwijt te raken —
  // opnieuw toevoegen zet 'm terug op true en je staat weer waar je was.
  subscribed       Boolean  @default(true)

  @@unique([userId, courseId])
  @@index([currentChapterId])
}

// --- Podcastcursus ("Geloof je dat ook?") ----------------------------------
//
// Elke aflevering krijgt twee losse, onafhankelijk af te ronden "modi":
// CONTENT (over de aflevering zelf) en BOM_CONNECTION (de brug naar het
// Boek van Mormon). Bewust een apart model in plaats van Chapter/Exercise
// hergebruiken — een aflevering heeft geen verzen, wel een titel/luisterlink,
// en de twee modi hebben allebei hun eigen voortgang, als aparte "lessen".

// Eén rij per podcast (bv. "Geloof je dat ook?", "De Kast van Mormon"). De
// vaste lijst staat in src/lib/podcasts.ts en wordt door syncCourses
// bijgewerkt; elke podcast krijgt een eigen PODCAST-cursus (Course.podcastId).
model Podcast {
  id       String  @id
  slug     String  @unique
  name     String
  feedUrl  String?
  order    Int     @default(0)

  episodes PodcastEpisode[]
  courses  Course[]
}

model PodcastEpisode {
  id          String    @id @default(cuid())
  podcastId   String
  podcast     Podcast   @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  // Uniek per podcast, niet over alles heen: beide podcasts hebben een
  // "aflevering 12".
  number      Int
  title       String
  summary     String?
  // Link naar de afleveringspagina/website (RSS <link>) — voor de
  // "bekijk op de website"-link. Het daadwerkelijk afspeelbare bestand (RSS
  // <enclosure>, meestal een mp3-URL) staat apart in audioUrl, voor de
  // ingebouwde speler (zie PodcastCourseView.tsx) — dat is bewust NIET
  // dezelfde waarde, een webpagina kan immers niet als <audio src> dienen.
  listenUrl   String?
  audioUrl    String?
  // Uit <podcast:transcript> in de feed (meestal een .vtt), als de makers
  // die meeleveren: de bron voor nieuwe oefeningen.
  transcriptUrl String?
  // Hoofdstukken uit <podcast:chapters> in de feed: de URL van het
  // hoofdstukkenbestand (om alleen bij een wijziging opnieuw op te halen) en
  // de hoofdstukken zelf als JSON-tekst: [{ "start": seconden, "title": "..." }],
  // oplopend. Null als de feed er geen meegeeft.
  chaptersUrl String?
  chapters    String?
  publishedAt DateTime?
  order       Int       @default(0)

  exercises        PodcastExercise[]
  progress         PodcastEpisodeProgress[]
  playbackProgress PodcastPlaybackProgress[]

  @@unique([podcastId, number])
}

// Onthoudt waar je gebleven was met luisteren (zie PodcastMiniPlayer.tsx) —
// los van PodcastEpisodeProgress hierboven, dat over de oefeningen gaat.
// Server-side (i.p.v. alleen lokaal in de browser) zodat je op een ander
// apparaat verder kan luisteren waar je gebleven was. Eén rij per
// gebruiker+aflevering; wordt verwijderd zodra een aflevering (bijna)
// helemaal is afgeluisterd, zodat een volgende keer weer bij het begin
// begint i.p.v. bij "nog 3 seconden te gaan".
model PodcastPlaybackProgress {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId       String
  episode         PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  positionSeconds Float
  updatedAt       DateTime       @updatedAt

  @@unique([userId, episodeId])
}

enum PodcastExerciseMode {
  CONTENT
  BOM_CONNECTION
}

// Handmatig geschreven (zie prisma/podcastContent.ts) — net als de
// begrijpend-lezen-oefeningen bij boekhoofdstukken, kan dit niet automatisch
// uit een transcript gegenereerd worden.
model PodcastExercise {
  id        String                  @id @default(cuid())
  episodeId String
  episode   PodcastEpisode          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  mode      PodcastExerciseMode
  order     Int
  type      ExerciseType
  prompt    String
  answers   String // JSON-array van geaccepteerde antwoorden
  wordBank  String? // JSON-array voor SEQUENCE-opgaven
  options   PodcastExerciseOption[]

  attempts PodcastExerciseAttempt[]
}

model PodcastExerciseOption {
  id         String          @id @default(cuid())
  exerciseId String
  exercise   PodcastExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  label      String
  isCorrect  Boolean         @default(false)
  order      Int             @default(0)
}

model PodcastExerciseAttempt {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   PodcastExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  givenText  String
  correct    Boolean
  createdAt  DateTime        @default(now())
}

model PodcastEpisodeProgress {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId   String
  episode     PodcastEpisode      @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  mode        PodcastExerciseMode
  completed   Boolean             @default(false)
  bestScore   Int                 @default(0)
  xpEarned    Int                 @default(0)
  completedAt DateTime?

  @@unique([userId, episodeId, mode])
}

// "Verhalen uit het Boek van Mormon" (kindercursus, o.b.v. het gelijknamige
// officiële kinderboek — met toestemming gebruikt, zie prisma/importKids.ts).
// Eigen modelfamilie, net als Podcast*, omdat een KidsStory geen echt
// Chapter/Verse is. Elke kindercursus heeft eigen verhalen: de oudere
// Nederlandse uitgave (kidsManifest.json) en de uitgave 2023 per taal
// (kidsStories2023.<taal>.json). Hetzelfde nummer is in elke taal van die
// uitgave hetzelfde verhaal.
model KidsStory {
  id        String  @id @default(cuid())
  courseId  String?
  course    Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  subtitle  String?
  reference String? // bv. "1 Nephi 1–2", zoals in de uitgave
  text      String
  images    String // JSON-array van afbeeldings-URL's (public/kids/images of de server van de kerk)
  order     Int     @default(0)

  exercises KidsExercise[]
  progress  KidsStoryProgress[]

  @@unique([courseId, number])
}

model KidsExercise {
  id       String               @id @default(cuid())
  storyId  String
  story    KidsStory            @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order    Int
  type     ExerciseType
  prompt   String
  answers  String // JSON-array van geaccepteerde antwoorden
  wordBank String? // JSON-array voor WORD_BANK-opgaven
  options  KidsExerciseOption[]

  attempts KidsExerciseAttempt[]
}

model KidsExerciseOption {
  id         String       @id @default(cuid())
  exerciseId String
  exercise   KidsExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  label      String // leeg voor IMAGE_CHOICE (dan telt alleen imageUrl)
  imageUrl   String? // gezet voor IMAGE_CHOICE-opties
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)
}

model KidsExerciseAttempt {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   KidsExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  givenText  String
  correct    Boolean
  createdAt  DateTime     @default(now())
}

model KidsStoryProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId     String
  story       KidsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  bestScore   Int       @default(0)
  xpEarned    Int       @default(0)
  completedAt DateTime?

  @@unique([userId, storyId])
}

// --- Voor de kracht van de jeugd -------------------------------------------
//
// Deze lessen komen uit de officiële maandelijkse FSY-lespagina's. Ze zijn
// bewust geen Chapter/Verse en ook geen oefening: eerst tonen we alleen tekst
// en afbeeldingen. De actuele gescrapete versie en de laatst gepubliceerde
// versie staan apart zodat een bronwijziging niet automatisch zichtbaar wordt
// wanneer autoPublish uitstaat.
model FsyLesson {
  id                  String          @id @default(cuid())
  contentCollectionId String
  contentCollection   ContentCollection @relation(fields: [contentCollectionId], references: [id], onDelete: Cascade)
  year                Int
  month               Int
  category            String
  slug                String
  title               String
  content             String          // JSON-array met tekst- en afbeeldingsblokken
  images              String          // JSON-array met {url, alt}
  sourceUrl           String
  sourceHash          String
  status              FsyLessonStatus @default(DRAFT)
  publishedTitle      String?
  publishedContent    String?
  publishedImages     String?
  publishedAt         DateTime?
  lastScrapedAt       DateTime         @default(now())
  order               Int              @default(0)

  @@unique([contentCollectionId, sourceUrl])
  @@unique([contentCollectionId, year, month, slug])
  @@index([contentCollectionId, year, month, status, order])
}

enum FsyLessonStatus {
  DRAFT
  PUBLISHED
}

// --- Introductiecursus ("Ontdek het Boek van Mormon") ----------------------
//
// Eigen modelfamilie, net als Kids*/Podcast* hierboven — een IntroLesson is
// geen Chapter/Verse (geen schrifttekst, maar zelfgeschreven uitleg +
// verwijzingen naar echte content, zie het "content"-veld hieronder), en zo
// blijft Book/Chapter/Verse (en alles wat daarvan uitgaat, zoals "Raad het
// hoofdstuk" en de boek-per-boek-lijst) vrij van niet-schriftuurlijke content.
//
// `content` is een JSON-array van content-blokken (getypeerd in
// prisma/introContent.ts, niet hier in het schema — zie dat bestand voor de
// exacte vorm). Blokken verwijzen voor echte tekst/personen/boeken altijd
// naar bestaande Verse/Person/Book-rijen (via slug/nummer), nooit met
// gekopieerde tekst — zo kan er nooit verzonnen brontekst insluipen en blijft
// alles vanzelf in sync met een her-import van de brontekst.
model IntroLesson {
  id      String @id @default(cuid())
  number  Int    @unique
  slug    String @unique
  title   String
  summary String? // korte "wat leer je"-tekst voor het cursusoverzicht
  content String // JSON-array van content-blokken, zie prisma/introContent.ts
  order   Int    @default(0)

  exercises IntroExercise[]
  progress  IntroLessonProgress[]
}

// Handmatig geschreven (zie prisma/introContent.ts) — net als bij Kids/
// Podcast kan dit niet automatisch uit brontekst gegenereerd worden, want de
// vragen gaan over lesconcepten, niet over een specifiek vers.
model IntroExercise {
  id       String                @id @default(cuid())
  lessonId String
  lesson   IntroLesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order    Int
  type     ExerciseType
  prompt   String
  answers  String // JSON-array van geaccepteerde antwoorden
  wordBank String? // JSON-array voor WORD_BANK/SEQUENCE-opgaven
  options  IntroExerciseOption[]

  attempts IntroExerciseAttempt[]
}

model IntroExerciseOption {
  id         String        @id @default(cuid())
  exerciseId String
  exercise   IntroExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  label      String
  isCorrect  Boolean       @default(false)
  order      Int           @default(0)
}

model IntroExerciseAttempt {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   IntroExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  givenText  String
  correct    Boolean
  createdAt  DateTime      @default(now())
}

model IntroLessonProgress {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      IntroLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean     @default(false)
  bestScore   Int         @default(0)
  xpEarned    Int         @default(0)
  completedAt DateTime?

  @@unique([userId, lessonId])
}

// Zelfgerapporteerd kennisniveau bij de onboarding (zie User.bomKnowledgeLevel
// hierboven) — bepaalt alleen de voorgestelde volgorde, nooit een blokkade.
enum IntroKnowledgeLevel {
  NEVER // "Nog nooit"
  SOME // "Een paar stukjes"
  READ_BEFORE // "Ik heb het al eens gelezen"
  UNSURE // "Ik weet het eigenlijk niet meer"
}

// De drie personages die je als persoonlijke gids kunt kiezen (User.companion).
// In de app heten ze "novi", "varo" en "vera" (src/lib/mascots.ts); de namen
// worden nooit vertaald.
enum Companion {
  NOVI
  VARO
  VERA
}

// Persoonlijke volgorde van cursussen/spelletjes (sleep-en-herordenen op
// /courses en /live) — één generiek mechanisme voor beide lijsten i.p.v. twee
// losse ad-hoc kolommen. Geen rij voor een item = gebruik de standaardvolgorde
// (Course.order, resp. de vaste volgorde in de spelletjeslijst) — dus een
// gebruiker die nooit herordent, merkt nooit iets van deze tabel.
model UserListOrder {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  listKey String // "courses" | "games"
  itemKey String // Course.id, resp. een vaste spelletjes-slug
  order   Int
  // Door de gebruiker verborgen uit het eigen overzicht (alleen spellen;
  // bij cursussen is dat UserCourseProgress.subscribed). Zegt niets over
  // of iets beschikbaar is: dat blijft bij GameSettings/de content.
  hidden  Boolean @default(false)

  @@unique([userId, listKey, itemKey])
}

model Verse {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  number    Int
  text      String
  // Waar dit vers begint in Chapter.audioUrl, in seconden; het vers loopt
  // tot het begin van het volgende. Null = hoofdstuk zonder audio.
  audioStart Float?

  people     VersePerson[]
  places     VersePlace[]
  topics     VerseTopic[]
  bookmarks  Bookmark[]
  highlights Highlight[]
  notes      Note[]
  exercises  Exercise[]

  @@unique([chapterId, number])
}

// --- Context: personen, plaatsen en thema's --------------------------------
// Fase-4-fundament (zie productplan): het datamodel staat, de profielpagina's
// en thema-filters worden in een latere fase gebouwd.

model Person {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  gender      String?       // "man", "vrouw" of null voor onbekend
  fatherId    String?
  father      Person?       @relation("FathersChildren", fields: [fatherId], references: [id], onDelete: SetNull)
  children    Person[]      @relation("FathersChildren")
  motherId    String?
  mother      Person?       @relation("MothersChildren", fields: [motherId], references: [id], onDelete: SetNull)
  motherChildren Person[]   @relation("MothersChildren")
  verses      VersePerson[]
  // Bij welk schrift deze persoon hoort (/tools/persons toont die van de
  // actieve collectie). Bestaande personen komen allemaal uit het Boek van
  // Mormon, vandaar de standaardwaarde.
  contentCollectionId String            @default("content_bom")
  contentCollection   ContentCollection @relation(fields: [contentCollectionId], references: [id], onDelete: Cascade)

  @@index([contentCollectionId])
}

model Place {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  verses      VersePlace[]
}

model Topic {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  verses      VerseTopic[]
}

model VersePerson {
  id       String  @id @default(cuid())
  verseId  String
  verse    Verse   @relation(fields: [verseId], references: [id], onDelete: Cascade)
  personId String
  person   Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     String? // bv. "spreker", "genoemd"

  @@unique([verseId, personId])
}

model VersePlace {
  id      String @id @default(cuid())
  verseId String
  verse   Verse  @relation(fields: [verseId], references: [id], onDelete: Cascade)
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([verseId, placeId])
}

model VerseTopic {
  id      String @id @default(cuid())
  verseId String
  verse   Verse  @relation(fields: [verseId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([verseId, topicId])
}

// --- Leeservaring: bladwijzers, highlights, notities, leesmomenten --------

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verseId   String
  verse     Verse    @relation(fields: [verseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, verseId])
  @@index([verseId])
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verseId   String
  verse     Verse    @relation(fields: [verseId], references: [id], onDelete: Cascade)
  color     String   @default("yellow")
  createdAt DateTime @default(now())

  @@unique([userId, verseId])
  @@index([verseId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verseId   String
  verse     Verse    @relation(fields: [verseId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, verseId])
  @@index([verseId])
}

// Een "leesmoment": aparte registratie van het lézen, los van de quiz erna.
// Nodig voor "ga verder waar je gebleven was" en om lezen te kunnen meten
// zonder dat het per se aan een voltooide quiz hangt.
model ReadingSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId  String
  chapter    Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([chapterId])
}

// --- Oefeningen: gekoppeld aan concrete brontekst, bewust weinig multiple
// choice (invullen, volgorde, waar/niet waar) -----------------------------
//
// `status` bereidt de AI-contentworkflow uit het productplan voor: nu is
// alles automatisch gegenereerd en meteen APPROVED, maar handmatig
// gecontroleerde of AI-voorgestelde vragen kunnen straks als DRAFT/IN_REVIEW
// binnenkomen zonder dat gebruikers ze al te zien krijgen (zie
// src/app/api/chapters/[chapterId]/route.ts, dat alleen APPROVED serveert).

enum ExerciseType {
  FILL_BLANK
  WORD_BANK
  TRUE_FALSE
  // Begrijpend-lezen-vraagtypes (handmatig geschreven, niet automatisch
  // gegenereerd uit brontekst — zie src/lib/exerciseGen.ts).
  MULTIPLE_CHOICE // vrije vraag + N keuzeopties (QuestionOption), bv. kernboodschap/motivatie/wie-zei-dit
  SEQUENCE // zet gebeurtenis-samenvattingen in de juiste volgorde; zelfde databron als WORD_BANK (answers/wordBank)
  // Zelfde mechaniek als MULTIPLE_CHOICE, maar de keuzeopties zijn
  // afbeeldingen (KidsExerciseOption.imageUrl) i.p.v. tekst. Zie de
  // kindercursus in prisma/kidsContent.ts.
  IMAGE_CHOICE
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

model Exercise {
  id            String           @id @default(cuid())
  chapterId     String
  chapter       Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order         Int
  type          ExerciseType
  status        ContentStatus    @default(APPROVED)
  verseRef      String // bv. "1 Nephi 3:7"
  sourceVerseId String?
  sourceVerse   Verse?           @relation(fields: [sourceVerseId], references: [id], onDelete: SetNull)
  prompt        String // tekst met "____" op de plek van het weggelaten woord, of de stelling bij TRUE_FALSE
  answers       String // JSON-array van geaccepteerde antwoorden (of ["true"]/["false"])
  hint          String? // Zelfgeschreven/gegenereerde denkhint die het antwoord niet rechtstreeks verklapt
  wordBank      String? // JSON-array van keuzewoorden voor WORD_BANK type
  options       QuestionOption[]

  attempts ExerciseAttempt[]
  credits  ContentExerciseCredit[]
  courseLessonLinks CourseLessonExercise[]

  @@index([chapterId])
  @@index([sourceVerseId])
}

// Nog niet gebruikt door de huidige generatoren (FILL_BLANK/WORD_BANK/
// TRUE_FALSE hebben er geen nodig), maar aanwezig zodat toekomstige
// selectie-achtige vraagtypes (bv. "wie zei dit?", "koppel persoon aan
// gebeurtenis") zonder schemawijziging toegevoegd kunnen worden.
model QuestionOption {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  label      String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@index([exerciseId])
}

model ExerciseAttempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  givenText  String
  correct    Boolean
  createdAt  DateTime @default(now())

  @@index([exerciseId])
}

// Vervangen door ContentProgress (zie hieronder): blijft alleen bestaan als
// bron voor de eenmalige overzetting in migratie
// 20261002150000_learning_progress. Niet meer lezen of schrijven.
model ChapterProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId   String
  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  bestScore   Int       @default(0) // percentage 0-100
  xpEarned    Int       @default(0)
  completedAt DateTime?

  @@unique([userId, chapterId])
  @@index([chapterId])
}

// --- Leervoortgang per inhoud (zie docs/LEERVOORTGANG.md) -----------------
//
// Leesvoortgang hoort bij de inhoud, niet bij de cursus. contentKey is de
// sleutel van src/lib/learning/contentIdentity.ts ("bofm/alma#32"): dezelfde
// in elke leesroute en elke taaleditie, dus wat je via de ene route of taal
// leest of oefent, telt overal.

enum ContentReadStatus {
  READING
  READ
}

model ContentProgress {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentKey String
  // Het hoofdstuk (in een bepaalde taal) dat het laatst gebruikt is, om
  // ernaar terug te linken. Geen relatie: de voortgang hoort bij de inhoud.
  lastChapterId String?

  // --- Lezen: geeft nooit XP en verlengt geen reeks ---
  readStatus    ContentReadStatus?
  // Tot welk vers gelezen is via leesgedeelten (Stap voor stap).
  readVerse     Int       @default(0)
  readStartedAt DateTime?
  readAt        DateTime?

  // --- Oefenen: de oefenset van N vragen (src/lib/learning/exercisePlan.ts) ---
  // Verschillende vragen die al gemaakt zijn (max N): "Oefeningen 8/12".
  exerciseAnswered     Int       @default(0)
  exercisesCompletedAt DateTime?

  // --- Beloning: alleen omhoog, ook niet terug bij het resetten van de
  // leesvoortgang; anders is dezelfde basis-XP opnieuw te verdienen.
  rewardCorrect Int       @default(0)
  rewardBonusAt DateTime?
  baseXpEarned  Int       @default(0)

  // Uit de voortgang van vóór dit systeem (migratie): de XP die toen al
  // voor deze inhoud is verdiend, of het hoofdstuk afgerond was en de beste
  // score. Pas met het aantal vragen N om te rekenen naar beantwoorde en
  // beloonde vragen; zie withLegacy in src/lib/learning/rewards.ts.
  legacyXp        Int     @default(0)
  legacyCompleted Boolean @default(false)
  legacyScore     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, contentKey])
}

// Per gebruiker per vraag: is deze vraag voor deze inhoud al gemaakt, en al
// goed (en dus beloond)? Zo levert dezelfde vraag nooit twee keer XP op,
// ook niet via een andere route of een tweede gelijktijdige inzending.
model ContentExerciseCredit {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  contentKey String
  correct    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, exerciseId])
  @@index([userId, contentKey])
}

// Een oefenset zoals de server hem heeft uitgedeeld. Alleen deze vragen
// tellen bij het inleveren, alles moet beantwoord zijn, en een set telt
// precies één keer (submittedAt): dubbelklikken of opnieuw insturen levert
// niets extra op.
model ExerciseSession {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId      String
  chapter        Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  contentKey     String
  // JSON-array met de uitgedeelde Exercise-id's.
  exerciseIds    String
  // Gezet bij een stap van Stap voor stap; null bij de volledige oefenset.
  courseLessonId String?
  courseLesson   CourseLesson? @relation(fields: [courseLessonId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  submittedAt    DateTime?

  @@index([userId, createdAt])
}

// --- XP: elke mutatie is een transactie, auditbaar en met een reden -------
// (user.xpTotal blijft een cache voor snelle reads, zie src/lib/xp.ts)

enum XPReason {
  LESSON_COMPLETED
  PERFECT_SCORE
  LIVE_GAME_PLAYED
  LIVE_GAME_WON
  ACHIEVEMENT
  // "Snelle ronde": korte, chapter-loze oefensessie die wel je dagstreak
  // redt maar geen hoofdstuk-cursus vooruit helpt. Zie completeQuickPractice.
  QUICK_PRACTICE
  // Eén van de twee modi (inhoud/verband met het Boek van Mormon) van een
  // podcastaflevering afgerond. Zie completePodcastLesson.
  PODCAST_LESSON_COMPLETED
  // Een verhaal uit de kindercursus afgerond. Zie completeKidsStory.
  KIDS_STORY_COMPLETED
  // Negatief bedrag: XP ingewisseld voor hints in de winkel. Zie src/lib/shop.ts.
  HINT_PURCHASED
  // Negatief bedrag: XP ingewisseld voor streak freezes in de winkel. Zie src/lib/shop.ts.
  FREEZE_PURCHASED
  // "Raad het hoofdstuk" — zowel alleen als live met vrienden. Zie
  // completeChapterGuess in src/lib/streak.ts.
  CHAPTER_GUESS_COMPLETED
  // Het dagelijkse woordspel (woord raden) goed geraden. Zie
  // completeWordGame in src/lib/streak.ts.
  WORD_GAME_WON
  // Een les uit de introductiecursus afgerond. Zie completeIntroLesson.
  INTRO_LESSON_COMPLETED
  // De Alleskenner alleen gespeeld (van de dag of vrij oefenen). Zie
  // completeAlleskennerSolo.
  ALLESKENNER_SOLO
  // Een onbeperkte woordzoeker afgerond. De spelronde zelf staat los van een dag.
  WORD_SEARCH_COMPLETED
  // Een ronde Samen studeren gespeeld. Zie completeStudyRound.
  STUDY_TOGETHER
}

model XPTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    XPReason
  metadata  String? // JSON, bv. {"chapterId": "..."}
  createdAt DateTime @default(now())
}

// --- Achievements -----------------------------------------------------------

model Achievement {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  description      String
  icon             String // emoji
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
}

// Sociale feed-items worden server-side aangemaakt bij XP en prestaties.
// XP-items worden binnen één activiteitstype maximaal vijftien minuten
// samengevoegd, zodat de feed geen rij per antwoord krijgt.
model ActivityFeedItem {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String       // XP of ACHIEVEMENT
  groupKey        String       // activiteitstype voor het XP-venster
  xpAmount        Int          @default(0)
  xpReason        XPReason?
  achievementSlug String?
  achievementName String?
  achievementIcon String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  reactions ActivityFeedReaction[]

  @@index([userId, updatedAt])
  @@index([userId, kind, groupKey, createdAt])
}

model ActivityFeedReaction {
  id        String           @id @default(cuid())
  itemId    String
  item      ActivityFeedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime         @default(now())
  notificationBatchId String?
  notificationBatch ActivityReactionNotificationBatch? @relation(fields: [notificationBatchId], references: [id], onDelete: SetNull)

  @@unique([itemId, userId])
  @@index([userId])
  @@index([notificationBatchId])
}

// Een batch verzamelt nieuwe reacties van één ontvanger tot het venster is
// verstreken. De scheduler verstuurt hem server-side; de client is nooit de
// timer of bron van waarheid voor reactiemeldingen.
model ActivityReactionNotificationBatch {
  id              String                   @id @default(cuid())
  recipientUserId String
  recipient       User                     @relation("ActivityReactionNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  firstReactionAt DateTime
  sendAfter       DateTime
  sentAt          DateTime?
  createdAt       DateTime                 @default(now())
  reactions       ActivityFeedReaction[]

  @@index([sentAt, sendAfter])
  @@index([recipientUserId, sentAt])
}

// --- Streak freezes -------------------------------------------------------

enum FreezeTxType {
  EARNED
  AUTO_SPENT
  GIFT_SENT
  GIFT_RECEIVED
  // Ingewisseld tegen XP in de winkel. Zie src/lib/shop.ts.
  PURCHASED
  // Aangeboden om een groepsreeks te beschermen (src/lib/social/groupFreeze.ts):
  // bij het aanbieden alvast apart gezet (-1), en terug (+1) als hij niet
  // nodig bleek. Werd hij wel gebruikt, dan blijft het bij de -1.
  GROUP_RESERVED
  GROUP_RELEASED
}

model FreezeTransaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation("FreezeOwner", fields: [userId], references: [id], onDelete: Cascade)
  type      FreezeTxType
  amount    Int
  relatedId String?
  related   User?        @relation("FreezeRelated", fields: [relatedId], references: [id], onDelete: SetNull)
  reason    String?
  createdAt DateTime     @default(now())
  seenAt    DateTime?
}

// Eén rij per dag die meetelt voor de reeks-kalender (zie /streak): STUDIED
// voor een dag waarop echt geoefend is, FROZEN voor een gemiste dag die
// automatisch door een reeksbevriezing is overbrugd (streakContinuation.ts),
// RETURNED voor een geslaagde terugkeerdag. Geen rij betekent niet geoefend. Los
// van User.currentStreak/lastStudyDate (die blijven de snelle cache voor
// "wat is mijn streak nu") — dit is puur de geschiedenis voor de kalender.
enum StreakDayStatus {
  STUDIED
  FROZEN
  RETURNED
}

// Eén afgeronde activiteit telt eenmaal, ook over retries, tabbladen en daggrenzen.
model StreakActivity {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  key String
  createdAt DateTime @default(now())

  @@unique([userId, key])
}

model StreakDay {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey    String // yyyy-mm-dd, dezelfde dag-bucket als User.lastStudyDate
  status    StreakDayStatus
  createdAt DateTime        @default(now())
  // Server-side claim zodat de reeksviering op meerdere tabs/apparaten maar één keer verschijnt.
  celebrationShownAt DateTime?

  @@unique([userId, dayKey])
  // Voor Samen: de minuuttaak in scheduler.ts zoekt alleen de nieuwe rijen
  // sinds de vorige ronde, zonder de hele tabel te doorlopen.
  @@index([createdAt])
}

// --- Vrienden -------------------------------------------------------------

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  sender     User             @relation("FriendSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User             @relation("FriendReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  @@unique([senderId, receiverId])
}

// --- Wekelijkse competitie -------------------------------------------------

// Divisies (secties 9 uit het productplan): elke gebruiker zit per week in
// precies één tier, en binnen die tier in een groep van (configureerbaar,
// zie LeagueSettings) ~30 spelers. Promotie/degradatie wordt "lazy"
// berekend zodra iemand voor het eerst die week actief wordt (zie
// resolveWeeklyPlacement in src/lib/leagues.ts) — dat werkt zonder een
// aparte cron-taak en is functioneel gelijkwaardig aan een wekelijkse
// batchjob die op maandag draait.
enum LeagueTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  MASTER
  GRANDMASTER
  LEGEND
}

// Eén "poule" van spelers binnen een tier, voor één week — de daadwerkelijke
// promotie/degradatie-groep (zie sectie 3/4 van het productplan: een tier
// bestaat uit meerdere groepen van elk ~30 spelers, niet één grote pot).
// memberCount is een cache, atomisch opgehoogd (zelfde updateMany-guard
// patroon als de hint-tegoeden bij ChapterGuessGame/ScrabbleGame) zodat een
// groep nooit voorbij `size` vol raakt ook bij gelijktijdige toewijzing.
model LeagueGroup {
  id           String        @id @default(cuid())
  weekStart    String // yyyy-mm-dd (maandag)
  tier         LeagueTier
  index        Int // welke groep binnen deze tier+week (0, 1, 2, ...)
  size         Int
  memberCount  Int           @default(0)
  // Het promotiepercentage dat gold toen de groep ontstond, zodat een latere
  // wijziging een lopende of afgelopen week niet verandert. Leeg: groep van
  // vóór deze regel, die volgt promoteCount op groupSize.
  promotePercent Int?
  createdAt    DateTime      @default(now())
  weeklyScores WeeklyScore[]

  @@unique([weekStart, tier, index])
}

model WeeklyScore {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart String // yyyy-mm-dd (maandag)
  xp        Int          @default(0)
  tier      LeagueTier   @default(BRONZE)
  // Beide nullable: bestaande rijen (van vóór groepen/seizoenen) blijven
  // geldig zonder backfill-gok — zie de migratie voor hoe bestaande rijen
  // alsnog een groep krijgen (seizoen bewust niet met terugwerkende kracht
  // toegekend, zie migratie-commentaar).
  groupId   String?
  group     LeagueGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  seasonId  String?
  season    Season?      @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@unique([userId, weekStart])
}

// --- Seizoenen ---------------------------------------------------------

enum SeasonStatus {
  ACTIVE
  COMPLETED
}

// Een seizoen omvat meerdere weken (configureerbaar via
// LeagueSettings.seasonWeekCount, standaard 6) van gewone wekelijkse
// competitie. weekCount wordt bij aanmaak gekopieerd vanuit de instellingen
// zodat een latere wijziging van die instelling een lopend seizoen niet met
// terugwerkende kracht verlengt/verkort.
model Season {
  id           String         @id @default(cuid())
  index        Int            @unique
  startWeek    String // yyyy-mm-dd (maandag van week 1)
  weekCount    Int
  status       SeasonStatus   @default(ACTIVE)
  createdAt    DateTime       @default(now())
  completedAt  DateTime?
  weeklyScores WeeklyScore[]
  results      SeasonResult[]
}

// Eindresultaat van één gebruiker over een afgesloten seizoen — zie
// runSeasonRolloverTick in src/lib/scheduler.ts, dat dit één keer per
// seizoen berekent en wegschrijft (geen live/lazy berekening, want dit heeft
// alle weken van het seizoen nodig om te kloppen).
model SeasonResult {
  id                 String     @id @default(cuid())
  seasonId           String
  season             Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  highestTier        LeagueTier
  finalTier          LeagueTier
  finalGroupPosition Int?
  promotions         Int        @default(0)
  demotions          Int        @default(0)
  activeWeeks        Int        @default(0)
  competitionsWon    Int        @default(0)
  createdAt          DateTime   @default(now())

  @@unique([seasonId, userId])
}

// --- Competitie-XP (anti-farming) ---------------------------------------

// Eén rij per keer dat een activiteit competitie-XP opleverde — de bron van
// waarheid voor de dagelijkse limiet/afnemende-meeropbrengst-regels in
// awardCompetitionXp (src/lib/competitionXp.ts). Los van XPTransaction
// (algemene XP, ongelimiteerd, ongemoeid) — zie het commentaar bij
// LeagueSettings.activityRules voor waarom dit een apart systeem is.
model CompetitionXpEvent {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityKey   String
  dayKey        String // yyyy-mm-dd (UTC-dagbucket, zie dayKey() in src/lib/dates.ts)
  weekStart     String // yyyy-mm-dd (maandag)
  rawAmount     Int
  awardedAmount Int
  metadata      String?
  createdAt     DateTime @default(now())

  @@index([userId, activityKey, dayKey])
}

// Eén configuratierij (zelfde singleton-patroon als EmailSettings/
// BrandingSettings) voor alles wat sectie 14 van het productplan expliciet
// niet op meerdere plekken hardgecodeerd wil hebben: groepsgrootte,
// promotie/degradatie-aantallen, seizoensduur, en de per-activiteit
// XP-regels. localeCode ligt nu vast op "nl-NL" (de enige actieve
// competitie) maar blokkeert een toekomstige en/de-competitie niet.
model LeagueSettings {
  id                      String   @id @default("singleton")
  groupSize               Int      @default(30)
  // Oude regel (aantal op groupSize), alleen nog voor groepen zonder eigen
  // promotePercent: groepen van vóór de 75%-regel.
  promoteCount            Int      @default(3)
  demoteCount             Int      @default(3)
  // Welk deel van een groep promoveert (afgerond naar beneden, minstens één).
  // Een nieuwe groep krijgt dit mee (LeagueGroup.promotePercent).
  promotePercent          Int      @default(75)
  // Niet meer gebruikt: een kleinere groep volgt nu dezelfde verhouding als
  // promoteCount/demoteCount op groupSize (zie movementCounts in
  // src/lib/leagues.ts). Blijft staan om geen data te laten vallen.
  minGroupSizeForMovement Int      @default(10)
  seasonWeekCount         Int      @default(6)
  localeCode              String   @default("nl-NL")
  // JSON: { [activityKey]: { dailyCap, decayFactor, winBonus?, levelMultiplier? } }
  // — zie DEFAULT_ACTIVITY_RULES in src/lib/competitionXp.ts voor de vorm en
  // de standaardwaarden waarmee dit veld geseed wordt.
  activityRules           String
  updatedAt               DateTime @updatedAt
}

// --- Live multiplayer quiz --------------------------------------------------

enum LiveGameStatus {
  LOBBY
  IN_PROGRESS
  FINISHED
}

// EXERCISES = het bestaande hoofdstuk-oefeningen-duel (chapterId verplicht).
// CHAPTER_GUESS = "Raad het hoofdstuk" (zie ChapterGuessGame hieronder) —
// niet aan één hoofdstuk gebonden, dus chapterId blijft dan leeg en level/
// questionCount zijn juist wel gezet.
// FAMILY_GAME = het Gezinsavondspel (zie src/lib/familyGame.ts) — ook niet
// aan één hoofdstuk gebonden; gebruikt in plaats daarvan familyGameMinutes/
// familyGameDiceMode hieronder. Bewust hergebruik van hetzelfde LiveGame-
// mechanisme (lobby, uitnodigen, annuleren) i.p.v. een aparte sessie-tabel —
// zie de sessie-samenvatting/het besproken ontwerp voor waarom.
enum LiveGameMode {
  EXERCISES
  CHAPTER_GUESS
  FAMILY_GAME
  ALLESKENNER
  // Samen studeren: een cursus met vrienden, stap voor stap (zie
  // StudySession hieronder en src/server/study.ts).
  STUDY
}

// Alleen relevant bij mode FAMILY_GAME. DIGITAL = de app gooit (server-
// side, zie gameServer.ts — nooit clientside, dat zou op afstand meespelende
// accounts kunnen laten valsspelen). PHYSICAL = een echte dobbelsteen; de
// speler voert het aantal ogen zelf in, de server vertrouwt die waarde net
// zoals bij elk ander door een mens ingevoerd spelresultaat.
enum FamilyGameDiceMode {
  DIGITAL
  PHYSICAL
}

model LiveGame {
  id            String             @id @default(cuid())
  code          String             @unique
  hostId        String
  host          User               @relation("GameHost", fields: [hostId], references: [id], onDelete: Cascade)
  mode          LiveGameMode       @default(EXERCISES)
  chapterId     String?
  chapter       Chapter?           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  level         ChapterGuessLevel?
  questionCount Int?
  // Alleen gezet bij mode FAMILY_GAME (zie hierboven).
  familyGameMinutes  Int?
  familyGameDiceMode FamilyGameDiceMode?
  status        LiveGameStatus     @default(LOBBY)
  createdAt     DateTime           @default(now())
  players       LiveGamePlayer[]
  invites       LiveGameInvite[]
  // Alleen bij een seizoensavond van De Alleskenner.
  alleskennerEvening AlleskennerEvening?
  // Alleen bij mode STUDY.
  studySession StudySession?

  @@index([chapterId])
}

model LiveGamePlayer {
  id       String   @id @default(cuid())
  gameId   String
  game     LiveGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score    Int      @default(0)
  joinedAt DateTime @default(now())

  @@unique([gameId, userId])
}

// Wie is uitgenodigd voor een nog niet gestarte lobby — een uitnodiging zelf
// is verder puur een live socketpushje (zie invite_friend in gameServer.ts),
// maar zonder dit record zou /api/activity-status niet kunnen zien of een
// verse, nog lege lobby al iemand heeft uitgenodigd. Dat onderscheid bepaalt
// of zo'n lobby als "wachten op reactie" getoond wordt (met een knop om 'm
// alsnog te beëindigen als er nooit gereageerd wordt) i.p.v. helemaal niet,
// zie ook: een gebruiker die zojuist "Maak spel" heeft geklikt zonder nog
// iemand uit te nodigen hoeft die sessie nergens als "actief" terug te zien.
model LiveGameInvite {
  id        String   @id @default(cuid())
  gameId    String
  game      LiveGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([gameId, userId])
}

// --- Samen studeren ----------------------------------------------------------
//
// Een cursus met vrienden doorwerken: de host kiest telkens een stap, die
// start voor iedereen tegelijk met dezelfde vragen; daarna een ranglijst
// voor die stap (goed beantwoord telt het zwaarst, wie eerst klaar is krijgt
// een kleine bonus) en een totaalranglijst die groeit zolang er gespeeld
// wordt. De lobby, uitnodigingen en deelnemers lopen via LiveGame (mode
// STUDY); hier staat wat een sessie langer dan één ronde bijhoudt, zodat de
// ranglijst ook een herstart van de server overleeft. Zie src/server/study.ts.
model StudySession {
  id        String       @id @default(cuid())
  gameId    String       @unique
  game      LiveGame     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  rounds    StudyRound[]

  @@index([courseId])
}

model StudyRound {
  id        String        @id @default(cuid())
  sessionId String
  session   StudySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  number    Int
  // Welke stap: "ch:<chapterId>", "rl:<courseLessonId>", "in:<introLessonId>",
  // "kd:<kidsStoryId>" of "pc:<episodeId>:<mode>" (zie src/lib/study/units.ts).
  unitKey   String
  unitLabel String
  // JSON: de vragen zoals iedereen ze kreeg (bron, id, en de geschudde
  // opties), zodat antwoorden later nog tegen dezelfde vraag kloppen.
  questions String
  startedAt DateTime
  closedAt  DateTime?
  answers   StudyAnswer[]

  @@unique([sessionId, number])
}

model StudyAnswer {
  id         String     @id @default(cuid())
  roundId    String
  round      StudyRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  index      Int
  correct    Boolean
  answeredAt DateTime   @default(now())

  @@unique([roundId, userId, index])
  @@index([userId])
}

// --- Raad het hoofdstuk ------------------------------------------------------
//
// Je krijgt het eerste vers van een willekeurig hoofdstuk te lezen en moet
// raden welk hoofdstuk dat is. BEGINNER kiest uit 4 opties, ADVANCED/EXPERT
// selecteert zelf boek + hoofdstuknummer (en bevestigt die keuze) — EXPERT is
// verder gelijk aan ADVANCED maar zonder hints. Speelbaar alleen (dit model)
// of live met vrienden (zie LiveGame.mode CHAPTER_GUESS, dat dezelfde
// spelregels via de socket-server implementeert in src/server/gameServer.ts).

enum ChapterGuessLevel {
  BEGINNER
  ADVANCED
  EXPERT
}

enum ChapterGuessGameStatus {
  IN_PROGRESS
  FINISHED
}

model ChapterGuessGame {
  id            String                 @id @default(cuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  level         ChapterGuessLevel
  questionCount Int
  currentIndex  Int                    @default(0)
  status        ChapterGuessGameStatus @default(IN_PROGRESS)
  questions     ChapterGuessQuestion[]
  createdAt     DateTime               @default(now())
  finishedAt    DateTime?
}

model ChapterGuessQuestion {
  id     String           @id @default(cuid())
  gameId String
  game   ChapterGuessGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  order  Int // 0-gebaseerde positie binnen dit spel

  // Geen Prisma-relatie naar Chapter voor deze twee velden: dit is
  // vergankelijke rondestaat (het juiste antwoord, geheim tot beantwoord),
  // geen duurzame koppeling die cascade-gedrag nodig heeft.
  chapterId String // het juiste antwoord
  optionIds String? // JSON: 4 hoofdstuk-ids (incl. chapterId), alleen bij BEGINNER

  hintUsed          Boolean  @default(false)
  answeredChapterId String?
  correct           Boolean?

  @@unique([gameId, order])
}

// --- Dagelijks woordspel (woord raden) --------------------------------
//
// Eén woord van de dag voor iedereen, gekozen uit de 5-letterwoorden van het
// Boek van Mormon (zie src/lib/wordGame.ts). De dag wisselt om 18:00
// Nederlandse tijd, niet om middernacht UTC — vandaar een eigen
// dayKey-functie i.p.v. dayKey() uit src/lib/dates.ts.
// @@unique([userId, dayKey]) is wat "één keer per dag" afdwingt.
model WordGame {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey     String
  word       String // het doelwoord van die dag, hier bewaard voor eenvoudige/consistente lookup
  guesses    String         @default("[]") // JSON: array van geraden woorden, in volgorde
  status     WordGameStatus @default(IN_PROGRESS)
  xpEarned   Int            @default(0)
  leaderboardXpBonus Int    @default(0) // Eenmalige XP-bonus voor een top-10-positie.
  leaderboardRank   Int?
  createdAt  DateTime       @default(now())
  finishedAt DateTime?
  // Wanneer dit woord voor deze speler vrijkwam: 18:00 in zijn tijdzone op
  // dayKey (zie wordGamePeriod). Het klassement telt de tijd daarna. Null =
  // potje van vóór de tijdzones, toen was dat 18:00 Nederlandse tijd.
  releasedAt DateTime?

  @@unique([userId, dayKey])
  @@index([dayKey, status, finishedAt])
}

// Het woord zelf komt uit een deterministische functie van de dayKey (zie
// getWordForDay in src/lib/wordGame.ts) — die was bewust "geen state nodig"
// ontworpen. In de praktijk bleek dat niet waterdicht: twee spelers die
// dezelfde avond na 18:00 speelden kregen ooit toch een ander woord,
// vermoedelijk omdat er tussen hun beurten een nieuwe versie van de app
// live ging (elke wijziging die de woordenlijst of de volgorde ervan
// raakt, verandert de uitkomst van diezelfde functie). Deze tabel legt het
// woord voor een dayKey vast zodra de allereerste speler van die dag 'm
// opvraagt (atomische upsert, zie getOrCreateTodayGame) — elke speler
// daarna krijgt gegarandeerd exact datzelfde, opgeslagen woord terug, ook
// als de code/woordenlijst ondertussen verandert.
//
// bonusSettledAt: wanneer de rangbonus (top 10, op tijd na de eigen 18:00)
// voor deze woorddag is uitgedeeld. Dat gebeurt pas als de woorddag overal
// ter wereld voorbij is (zie settleWordGameBonuses); null = nog niet.
model DailyWord {
  dayKey         String    @id
  word           String
  createdAt      DateTime  @default(now())
  bonusSettledAt DateTime?
}

enum WordGameStatus {
  IN_PROGRESS
  WON
  LOST
}

// Een woordzoeker wordt per start op de server gegenereerd. De volledige
// raster- en plaatsingsstaat blijft bewaard, zodat vernieuwen geen nieuwe
// puzzel oplevert en de client nooit zelf de oplossing hoeft te bepalen.
enum WordSearchDifficulty {
  EASY
  MEDIUM
  HARD
}

enum WordSearchGameStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model WordSearchGame {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentCollectionId  String
  contentCollection    ContentCollection     @relation(fields: [contentCollectionId], references: [id], onDelete: Cascade)
  difficulty           WordSearchDifficulty
  theme                String                @default("RANDOM")
  size                 Int
  seed                 Int
  grid                 String                // JSON: letterraster als string[][]
  words                String                // JSON: zichtbare woorden met posities
  foundWords           String                @default("[]")
  status               WordSearchGameStatus  @default(IN_PROGRESS)
  xpEarned             Int                   @default(0)
  createdAt            DateTime              @default(now())
  finishedAt           DateTime?

  @@index([userId, status])
  @@index([contentCollectionId])
}

// --- Notificaties (e-mail + browser push) ----------------------------------

// Meldingencentrum (de bel in de header, zie NotificationCenter.tsx): elke
// melding die ook als push/e-mail kan gaan, blijft hier staan tot de
// gebruiker erop tikt of hem wist. Push en e-mail gaan alleen als de app
// nergens open staat (zie notifyUser in src/lib/notify.ts); wie de app open
// heeft maar er niet naar kijkt, vindt de melding hier terug.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // groep in het meldingencentrum, zie src/lib/notificationGroups.ts
  title     String
  body      String
  url       String // waar tikken naartoe gaat
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Eén rij per browser/apparaat waarop een gebruiker pushnotificaties heeft
// toegestaan (de Web Push-standaard: elk apparaat/browser krijgt zijn eigen
// endpoint). Verwijderd zodra de browser 'm meldt als verlopen (410 Gone),
// zie src/lib/push.ts.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Singleton (net als EmailSettings): het VAPID-sleutelpaar waarmee de server
// zich bij pushdiensten (FCM/Mozilla/...) identificeert. Wordt automatisch
// gegenereerd bij eerste gebruik (zie src/lib/push.ts) — geen admin-actie
// nodig, in tegenstelling tot EmailSettings (SMTP moet je wel zelf weten).
model PushSettings {
  id         String @id @default("singleton")
  publicKey  String
  privateKey String
}

enum ChallengeStatus {
  PENDING
  DECLINED
  ACCEPTED
  FINISHED
}

// Asynchrone 1-op-1-uitdaging tussen twee vrienden op een specifiek
// hoofdstuk: beide spelen de oefeningen van dat hoofdstuk onafhankelijk van
// elkaar (niet gelijktijdig zoals LiveGame), en krijgen een notificatie
// zodra de ander aan de beurt is/heeft gespeeld. Scores zijn los van
// ChapterProgress/ExerciseAttempt — een uitdaging telt niet mee voor
// hoofdstukvoortgang, streak of XP (dat gebeurt al via de normale lesflow;
// dit is puur de "wie scoort beter"-vergelijking).
model Challenge {
  id         String          @id @default(cuid())
  chapterId  String
  chapter    Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User            @relation("ChallengeSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User            @relation("ChallengeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     ChallengeStatus @default(PENDING)

  senderScore         Int?
  senderCompletedAt   DateTime?
  receiverScore       Int?
  receiverCompletedAt DateTime?
  // null zolang status niet FINISHED is, of bij een gelijkspel. Bij een
  // normale afronding (beide gespeeld) de speler met de hoogste score; bij
  // opgeven altijd de andere speler, ongeacht scores (zie forfeitChallenge).
  winnerUserId        String?

  createdAt DateTime @default(now())

  @@index([receiverId])
  @@index([senderId])
  @@index([chapterId])
}

// --- Woordspel (woordlegspel, alleen woorden uit het Boek van Mormon) --
//
// Asynchroon en 1-op-1, net als Challenge hierboven (elke
// speler doet zijn zet wanneer het uitkomt) — geen realtime lobby zoals
// LiveGame. Het bord/de racks/de zak staan als JSON in deze ene rij, wat
// hier prima is: er is maar één actieve "lezer/schrijver" tegelijk (wie er
// nu aan de beurt is), dus geen concurrency-risico zoals bij een
// gedeelde realtime state.
enum ScrabbleGameStatus {
  PENDING
  DECLINED
  ACTIVE
  FINISHED
  // Uitnodiging ingetrokken door de uitdager voordat die beantwoord werd.
  // Niet verwijderd: de socketserver zoekt het spel op om de tegenspeler te
  // laten weten dat de uitnodiging weg is.
  CANCELLED
}

model ScrabbleGame {
  id        String             @id @default(cuid())
  player1Id String
  player1   User               @relation("ScrabblePlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2Id String
  player2   User               @relation("ScrabblePlayer2", fields: [player2Id], references: [id], onDelete: Cascade)
  status    ScrabbleGameStatus @default(PENDING)

  board       String // JSON: 15x15-grid, elke cel null of {letter, isBlank}
  bag         String // JSON: array van nog te trekken letters (trekvolgorde = array-volgorde)
  player1Rack String // JSON: array van huidige letters op het rek (max. 7)
  player2Rack String // JSON: array van huidige letters op het rek (max. 7)

  player1Score      Int     @default(0)
  player2Score      Int     @default(0)
  // null zolang status PENDING is; wordt bij ACCEPTED gezet op de uitnodiger
  // (die trekt als eerste, zoals gebruikelijk).
  turnUserId        String?
  // Aantal ACHTEREENVOLGENDE beurten zonder plaatsing (pas of wissel) —
  // bij een ingestelde drempel eindigt de partij daarmee ook zonder dat de
  // zak leeg hoeft te zijn (voorkomt een oneindig vastgelopen partij).
  consecutivePasses Int     @default(0)
  winnerUserId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moves ScrabbleMove[]

  @@index([player1Id])
  @@index([player2Id])
}

model ScrabbleMove {
  id     String       @id @default(cuid())
  gameId String
  game   ScrabbleGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String // "PLACE" | "EXCHANGE" | "PASS"
  tilesPlaced String? // JSON: [{row, col, letter, isBlank}] — alleen bij PLACE
  wordsFormed String? // JSON: string[] — alleen bij PLACE, voor de zetgeschiedenis
  score       Int     @default(0)

  createdAt DateTime @default(now())

  @@index([gameId])
}

// --- Feedback -----------------------------------------------------------

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  DONE
  WONT_DO
}

enum FeedbackKind {
  GENERAL
  EXERCISE
}

enum ExerciseFeedbackCategory {
  ANSWER_SHOULD_BE_ACCEPTED
  ANSWER_SHOULD_BE_REJECTED
  QUESTION_UNCLEAR
  ANSWERS_INCORRECT
  VISUAL_BROKEN
  OTHER
}

enum ExerciseFeedbackSource {
  SCRIPTURE
  INTRO
  KIDS
  PODCAST
}

// Een melding vanuit de profielpagina, met optioneel een screenshot. Wordt
// bij aanmaken gemaild naar de beheerder (zie src/lib/feedback.ts); die kan
// de status vanuit die mail bijwerken via een tokenlink (respondToken,
// geen login nodig — vandaar een apart, niet-giswaar token in plaats van
// het gewone id) of vanuit /adminbackend. De indiener ziet de bijgewerkte
// status terug op zijn eigen /feedback-pagina.
model Feedback {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  message      String
  // data-URL (base64), al verkleind/gecomprimeerd door de client vóór
  // verzenden — geen apart bestandsopslagsysteem nodig voor dit volume.
  screenshot   String?
  status       FeedbackStatus @default(NEW)
  respondToken String         @unique

  // Vraagmeldingen gebruiken dezelfde status-/adminflow als algemene feedback,
  // maar bewaren daarnaast stabiele vraagcontext zodat de tekst niet de enige
  // manier is om een probleem terug te vinden.
  kind             FeedbackKind              @default(GENERAL)
  questionId       String?
  questionSource   ExerciseFeedbackSource?
  questionCategory ExerciseFeedbackCategory?
  courseId         String?
  lessonId         String?
  contentKey       String?
  chapterId        String?
  verseRef         String?
  questionType     ExerciseType?
  givenAnswer      String?
  correctAnswer    String?
  uiLanguage       String?
  contentLanguage  String?
  questionSnapshot String?
  submissionKey    String?                    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([questionId, questionSource])
}

// Nieuws/wijzigingen die een admin publiceert via /adminbackend — de eerste
// echte lijst-achtige (niet-singleton) admin-content in de app; zie
// User.changelogEnabled/changelogSeenAt voor hoe een gebruiker dit te zien
// krijgt. Bewust platte tekst (geen markdown-rendering) om geen nieuwe
// afhankelijkheid toe te voegen voor iets dat prima met regeleinden werkt.
model ChangelogEntry {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// --- Huisstijl -----------------------------------------------------------

// Singleton (net als EmailSettings/PushSettings): optioneel eigen logo +
// favicon, in te stellen via /adminbackend. Als data-URL opgeslagen —
// zelfde reden als Feedback.screenshot hierboven, geen apart
// bestandsopslagsysteem nodig. Is logoDataUrl gezet, dan vervangt dat de
// tekst+emoji in de header (zie layout.tsx); faviconDataUrl vervangt op
// dezelfde manier het standaard favicon.ico (zie /api/branding/favicon).
// appName overschrijft op dezelfde manier de vaste APP_NAME uit
// src/lib/brand.ts (zie resolveAppName()), zonder dat daarvoor de broncode
// aangepast hoeft te worden. Een apart logo voor het welkomscherm bestaat
// niet meer: daar staat nu de mascottefamilie (family/welcome).
model BrandingSettings {
  id              String  @id @default("singleton")
  logoDataUrl    String?
  faviconDataUrl String?
  appName        String?
}

// Eén schakelaar per spelletje op de Spelen-pagina (/live) — door een admin
// uit te zetten via /adminbackend. Uitgezet betekent: de kaart verdwijnt uit
// het overzicht van gewone gebruikers (een admin blijft alles zien, met een
// andere kleur voor wat uitstaat) — bewust geen harde routeblokkade, zie de
// toelichting bij Course.enabled hierboven voor dezelfde afweging.
model GameSettings {
  id                   String  @id @default("singleton")
  wordGameEnabled      Boolean @default(true)
  scrabbleEnabled      Boolean @default(true)
  gezinsavondEnabled   Boolean @default(true)
  chapterGuessEnabled  Boolean @default(true)
  challengesEnabled    Boolean @default(true)
  liveExercisesEnabled Boolean @default(true) // "Nieuw spel starten"-formulier (oefeningen-race)
  // Standaard uit: een beheerder test het eerst (beheerders zien de kaart altijd).
  alleskennerEnabled   Boolean @default(false)
  jigsawEnabled        Boolean @default(false)
  wordSearchEnabled    Boolean @default(true)
  // Standaard uit: eerst inhoud, scoring en anti-cheat door een beheerder laten testen.
  quickMissionaryEnabled Boolean @default(false)
  // Eerste handgemaakte logicamysterie; los schakelbaar volgens hetzelfde
  // patroon als de andere spellen op /live.
  mysteryEnabled Boolean @default(true)
}

enum MysteryDifficulty {
  DISCOVERER
  INVESTIGATOR
  SCRIPTURE_SCHOLAR
}

// Historische voortgang van een vooraf ontworpen mysterie. Een poging zelf
// blijft client-state; deze rij bewaart alleen wat refresh en opnieuw spelen
// moet overleven. mysteryId en difficulty zijn stabiele interne sleutels.
model MysteryProgress {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mysteryId      String
  difficulty     MysteryDifficulty
  completed      Boolean           @default(false)
  completedAt    DateTime?
  hintCount      Int?
  tutorialSeenAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([userId, mysteryId, difficulty])
  @@index([userId, completed])
}

enum QuickMissionaryRunStatus {
  IN_PROGRESS
  DEAD_AWAITING_REVIVE
  REVIVE_READY
  FINISHED
}

// Serverregistratie van één arcade-run. De client rendert de wereld, maar
// alleen dit record bepaalt welke score ooit in een klassement kan komen.
model QuickMissionaryRun {
  id              String                    @id @default(cuid())
  userId          String
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt       DateTime                  @default(now())
  finishedAt      DateTime?
  dayKey          String
  score           Int                       @default(0)
  status          QuickMissionaryRunStatus  @default(IN_PROGRESS)
  reviveUsed      Boolean                   @default(false)
  reviveExerciseId String?
  reviveOptionIds String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([userId, status])
  @@index([userId, score])
  @@index([dayKey, status, score])
}

// --- De Alleskenner ----------------------------------------------------------
//
// Zie docs/ALLESKENNER.md. De inhoud komt uit prisma/alleskennerContent.ts
// (vaste ID's, elk feit met een bronvers) en wordt via de reseed geïmporteerd;
// de vorm van `data` per soort staat in src/lib/alleskenner/content.ts. Een
// potje zelf is een LiveGame met mode ALLESKENNER; de spelstatus leeft in het
// geheugen van de socketserver (src/server/alleskenner.ts).

enum AlleskennerItemKind {
  QUESTION // 3-6-9
  TOPIC // Open Deur en Finale: "Wat weet je van ...?"
  PUZZLE
  GALLERY
  MEMORY // Collectief Geheugen
}

model AlleskennerItem {
  id            String              @id // vaste ID uit alleskennerContent.ts, bv. "vraag-0001"
  kind          AlleskennerItemKind
  data          String // JSON, vorm per soort (zie src/lib/alleskenner/content.ts)
  enabled       Boolean             @default(true)
  // Door een beheerder aangepast in /adminbackend: de import overschrijft dit
  // onderdeel dan niet meer vanuit het contentbestand.
  editedByAdmin Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  seenBy        AlleskennerSeen[]
  translations  AlleskennerItemTranslation[]

  @@index([kind, enabled])
}

// Hetzelfde onderdeel in een andere contenttaal (data in dezelfde vorm als
// AlleskennerItem.data). Automatisch omgezet vanuit dezelfde bron (zie
// prisma/alleskennerTranslate.ts) of handgeschreven. Meerkeuzeopties staan in
// dezelfde volgorde als in het Nederlands, zodat spelers in verschillende
// talen op dezelfde vraag spelen. Een onderdeel dat de beheerder aanpaste
// (editedByAdmin) gebruikt geen vertalingen: die horen bij de oorspronkelijke tekst.
model AlleskennerItemTranslation {
  itemId    String
  item      AlleskennerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  language  String
  data      String
  updatedAt DateTime        @updatedAt

  @@id([itemId, language])
  @@index([language])
}

// Wat iemand al gezien heeft (als speler, quizmaster of toeschouwer), zodat
// een nieuw potje eerst onderdelen kiest die nog niemand van de deelnemers kent.
model AlleskennerSeen {
  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId String
  item   AlleskennerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  seenAt DateTime        @default(now())

  @@id([userId, itemId])
  @@index([itemId])
}

// --- De Alleskenner: alleen spelen (zie docs/ALLESKENNER.md, "Alleen spelen") --

enum AlleskennerSoloMode {
  DAILY // Alleskenner van de dag: voor iedereen dezelfde onderdelen, één poging
  PRACTICE // vrij oefenen: eigen onderdelen, telt niet mee in het klassement
}

enum AlleskennerSoloStatus {
  IN_PROGRESS
  FINISHED
  ABANDONED // zelf gestopt: telt niet mee, de poging van de dag is wel op
}

model AlleskennerSoloRun {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode       AlleskennerSoloMode
  // Alleen bij DAILY; de unieke index dwingt "één poging per dag" af
  // (meerdere NULLs mogen, dus oefenpotjes zijn onbeperkt).
  dayKey     String?
  items      String // JSON: gekozen onderdelen per ronde (zie src/lib/alleskenner/solo.ts)
  status     AlleskennerSoloStatus @default(IN_PROGRESS)
  seconds    Int                   @default(0)
  xpEarned   Int                   @default(0)
  createdAt  DateTime              @default(now())
  finishedAt DateTime?

  @@unique([userId, dayKey])
  @@index([mode, dayKey, status])
}

// De onderdelen van de Alleskenner van de dag, vastgelegd door de eerste die
// die dag speelt: zo krijgt iedereen dezelfde, ook als de inhoud tussendoor
// verandert (zelfde reden als DailyWord).
model AlleskennerDailySet {
  dayKey    String   @id
  items     String // JSON, zelfde vorm als AlleskennerSoloRun.items
  createdAt DateTime @default(now())
}

// --- De Alleskenner: seizoenen (zie docs/ALLESKENNER.md, "Seizoen") ---------

enum AlleskennerSeasonStatus {
  REGULAR // gewone avonden
  FINALE // seizoensfinale-avonden
  FINISHED
}

enum AlleskennerMemberStatus {
  WAITING // in de wachtrij, nog niet gespeeld
  ACTIVE // blijver: ongeslagen, nog geen 3 avonden
  ELIMINATED // finale van een avond verloren
  RETIRED // 3 avonden gespeeld, ongeslagen gestopt
}

enum AlleskennerEveningStatus {
  PLANNED
  DONE
  CANCELLED
}

model AlleskennerSeason {
  id           String                    @id @default(cuid())
  name         String
  hostId       String
  host         User                      @relation("AlleskennerSeasonHost", fields: [hostId], references: [id], onDelete: Cascade)
  deputyHostId String?
  deputyHost   User?                     @relation("AlleskennerSeasonDeputy", fields: [deputyHostId], references: [id], onDelete: SetNull)
  status       AlleskennerSeasonStatus   @default(REGULAR)
  championId   String?
  champion     User?                     @relation("AlleskennerSeasonChampion", fields: [championId], references: [id], onDelete: SetNull)
  createdAt    DateTime                  @default(now())
  finishedAt   DateTime?
  members      AlleskennerSeasonMember[]
  evenings     AlleskennerEvening[]

  @@index([hostId])
}

model AlleskennerSeasonMember {
  id            String                  @id @default(cuid())
  seasonId      String
  season        AlleskennerSeason       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId        String
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        AlleskennerMemberStatus @default(WAITING)
  queuePosition Int
  evenings      Int                     @default(0)
  points        Int                     @default(0) // 3/2/1 per gewone avond
  secondsTotal  Int                     @default(0) // gelijkstand in het klassement
  // Seizoensfinale: instapvolgorde (laagst geplaatste eerst), en of iemand al
  // is ingestapt of eruit ligt.
  finaleSeed    Int?
  finaleEntered Boolean                 @default(false)
  finaleOut     Boolean                 @default(false)
  joinedAt      DateTime                @default(now())

  @@unique([seasonId, userId])
  @@index([userId])
}

model AlleskennerEvening {
  id         String                   @id @default(cuid())
  seasonId   String
  season     AlleskennerSeason        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  number     Int
  isFinale   Boolean                  @default(false)
  isLast     Boolean                  @default(false) // laatste finaleavond: winnaar = Alleskenner van het seizoen
  gameId     String?                  @unique
  game       LiveGame?                @relation(fields: [gameId], references: [id], onDelete: SetNull)
  lineup     String // JSON: userIds in speelvolgorde (nieuwkomers eerst)
  newcomers  String // JSON: userIds die deze avond voor het eerst meedoen
  results    String? // JSON: [{ userId, place, seconds, points }]
  status     AlleskennerEveningStatus @default(PLANNED)
  createdAt  DateTime                 @default(now())
  finishedAt DateTime?

  @@index([seasonId])
}

// --- Samen: vriendenreeksen, groepen en seintjes --------------------------
//
// Zie docs/SAMEN.md. De persoonlijke reeks blijft de enige bron van waarheid:
// een dag telt voor een vriendenreeks of groepsreeks als die gebruiker op zijn
// eigen kalenderdag een StreakDay heeft (gestudeerd of bevroren). Hier staat
// dus geen eigen activiteit, alleen de stand van de sociale reeksen zelf.

enum FriendStreakStatus {
  PENDING // uitnodiging verstuurd
  ACTIVE
  DECLINED
  CANCELLED
  BROKEN // een dag niet allebei behouden
  ENDED // geen vrienden meer
}

model FriendStreak {
  id              String             @id @default(cuid())
  // Het paar, altijd met de kleinste id als A: zo is er één volgorde per paar.
  userAId         String
  userA           User               @relation("FriendStreakA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId         String
  userB           User               @relation("FriendStreakB", fields: [userBId], references: [id], onDelete: Cascade)
  inviterId       String
  inviter         User               @relation("FriendStreakInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  status          FriendStreakStatus @default(PENDING)
  // "A:B" zolang de reeks openstaat of loopt, daarna null: per paar hooguit
  // één open of lopende vriendenreeks (null mag vaker voorkomen).
  openKey         String?            @unique
  // Eerste dag die meetelt, en de eerste dag die nog niet definitief is
  // beoordeeld (yyyy-mm-dd, kalenderdagen zoals StreakDay.dayKey).
  startDay        String?
  nextDay         String?
  // Wanneer de oudste open dag (nextDay) voor beiden voorbij kan zijn: de
  // minuuttaak kijkt alleen naar reeksen die zover zijn.
  nextCheckAt     DateTime           @default(now())
  currentStreak   Int                @default(0)
  longestStreak   Int                @default(0)
  lastAchievedDay String?
  createdAt       DateTime           @default(now())
  acceptedAt      DateTime?
  endedAt         DateTime?

  events SocialEvent[]

  @@index([userAId, status])
  @@index([userBId, status])
  @@index([status, nextCheckAt])
}

model SocialGroup {
  id                String   @id @default(cuid())
  name              String
  // Gewone leden mogen hun eigen vrienden uitnodigen.
  membersCanInvite  Boolean  @default(true)
  // Zichtbaar op de openbare groepsranglijst (naam, aantal leden, reeks,
  // prestaties; nooit de leden). Standaard privé.
  showOnLeaderboard Boolean  @default(false)
  // Gewone leden mogen een toegangsverzoek van hun eigen vriend goedkeuren
  // (beheerders altijd, van iedereen).
  membersCanApprove Boolean  @default(true)
  // Groepslink/QR (zie src/lib/social/joinLinks.ts): een willekeurig,
  // niet te raden token dat alleen toegang geeft tot een beperkte
  // voorpagina en een toegangsverzoek, nooit tot lidmaatschap. Null = geen
  // actieve link. Intrekken maakt hem null; een nieuwe link krijgt altijd
  // een nieuw token. Staat los van showOnLeaderboard.
  joinLinkToken     String?  @unique
  joinLinkCreatedAt DateTime?
  // Snelle tellers voor lijsten en de ranglijst; de bron zijn de
  // lidmaatschappen en GroupDay.
  memberCount       Int      @default(0)
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  streakStartDay    String?
  lastAchievedDay   String?
  // Een gemiste dag verbreekt de reeks niet meer: de waarde blijft staan en
  // wordt hervat zodra de groep weer een normale groepsdag haalt.
  streakInterruptedDay String?
  // Eerste groepsdag die nog niet definitief is afgesloten, en wanneer dat op
  // zijn vroegst kan (iedereen moet die dag in de eigen tijdzone voorbij zijn).
  nextDay           String
  nextCheckAt       DateTime @default(now())
  // Minder dan 3 leden die meetellen: de reeks staat stil, maar blijft staan.
  paused            Boolean  @default(true)
  createdAt         DateTime @default(now())

  memberships  GroupMembership[]
  invites      GroupInvite[]
  days         GroupDay[]
  freezeOffers GroupFreezeOffer[]
  achievements GroupAchievement[]
  events       SocialEvent[]
  joinRequests GroupJoinRequest[]

  @@index([showOnLeaderboard, currentStreak])
  @@index([showOnLeaderboard, memberCount])
  @@index([nextCheckAt])
}

enum GroupRole {
  MEMBER
  ADMIN
}

// Eén rij per gebruiker per groep, ook na vertrek (leftAt): zo blijft de
// wachttijd voor opnieuw toetreden bewaard en telt de eigen bijdrage na
// terugkomst opnieuw vanaf de nieuwe instapdag.
model GroupMembership {
  id              String      @id @default(cuid())
  groupId         String
  group           SocialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            GroupRole   @default(MEMBER)
  adminSince      DateTime?
  joinedAt        DateTime    @default(now())
  // Eerste groepsdag waarop dit lid meetelt: de dag na de laatste dag die bij
  // het toetreden al bij een van de leden was begonnen (zie groups.ts).
  eligibleFromDay String
  // Tijdelijke uitsluiting voor de groepsreeks; persoonlijke voortgang en
  // rol blijven intact. Beide grenzen gelden inclusief.
  streakPauseFromDay      String?
  streakPauseUntilDay     String?
  lastStreakPauseEndedDay String?
  leftAt          DateTime?
  // Na vertrek of verwijdering pas na dit moment opnieuw lid.
  rejoinAfter     DateTime?

  @@unique([groupId, userId])
  @@index([userId, leftAt])
  @@index([groupId, leftAt])
}

enum GroupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model GroupInvite {
  id          String            @id @default(cuid())
  groupId     String
  group       SocialGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviterId   String
  inviter     User              @relation("GroupInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId   String
  invitee     User              @relation("GroupInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  status      GroupInviteStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?

  @@unique([groupId, inviteeId])
  @@index([inviteeId, status])
}

enum GroupDayStatus {
  OPEN
  ACHIEVED
  PROTECTED // doel niet gehaald, beschermd met een geschonken reeksbevriezing
  PAUSED // minder dan 3 leden die meetelden
  MISSED
}

// Eén rij per groepsdag die bekeken of afgesloten is. Een afgesloten dag
// (settledAt) verandert nooit meer; een gehaalde dag blijft gehaald.
model GroupDay {
  groupId          String
  group            SocialGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dayKey           String
  status           GroupDayStatus @default(OPEN)
  eligibleCount    Int?
  requiredCount    Int?
  contributorCount Int?
  perfect          Boolean        @default(false)
  streakAfter      Int?
  achievedAt       DateTime?
  settledAt        DateTime?

  @@id([groupId, dayKey])
  @@index([groupId, status, dayKey])
}

enum GroupFreezeOfferStatus {
  RESERVED
  RELEASED // niet nodig: terug naar de aanbieder
  CONSUMED // gebruikt om de groepsreeks te beschermen
  CANCELLED // aanbieder ging weg uit de groep: terug naar de aanbieder
}

// Hooguit één aangeboden reeksbevriezing per groepsdag. De wachttijd van 30
// dagen per gebruiker per groep volgt uit de CONSUMED-rijen zelf, dus
// verlaten en opnieuw toetreden zet hem niet terug.
model GroupFreezeOffer {
  id         String                 @id @default(cuid())
  groupId    String
  group      SocialGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dayKey     String
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     GroupFreezeOfferStatus @default(RESERVED)
  createdAt  DateTime               @default(now())
  resolvedAt DateTime?

  @@unique([groupId, dayKey])
  @@index([userId, groupId, status])
}

model GroupAchievement {
  groupId    String
  group      SocialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slug       String
  dayKey     String
  achievedAt DateTime    @default(now())

  @@id([groupId, slug])
}

// Geschiedenis van vriendenreeksen en groepen, voor een latere tijdlijn.
// userId is de betrokkene (bv. wie de reeks redde), bewust zonder relatie:
// de gebeurtenis blijft staan als dat account verdwijnt.
model SocialEvent {
  id             String        @id @default(cuid())
  kind           String
  groupId        String?
  group          SocialGroup?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  friendStreakId String?
  friendStreak   FriendStreak? @relation(fields: [friendStreakId], references: [id], onDelete: Cascade)
  userId         String?
  dayKey         String?
  data           String? // JSON, bv. {"streak": 184}
  createdAt      DateTime      @default(now())

  @@index([groupId, createdAt])
  @@index([friendStreakId, createdAt])
}

// Seintje (algemeen sociaal duwtje, niet alleen voor reeksen). Alleen het
// laatste seintje per richting: genoeg voor de grens van één per 6 uur, en er
// is bewust geen teller of geschiedenis.
model Nudge {
  senderId    String
  sender      User     @relation("NudgeSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("NudgeRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  context     String
  lastSentAt  DateTime @default(now())

  @@id([senderId, recipientId])
}

enum GroupJoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED // ingetrokken, of lid geworden langs een andere weg
}

// Toegangsverzoek via de groepslink. Het verzoek hoort bij de groep, niet
// bij één persoon: elke bevoegde (beheerder, of een lid dat een vriend van de
// aanvrager is als de groep dat toestaat) kan het afhandelen.
model GroupJoinRequest {
  id          String                 @id @default(cuid())
  groupId     String
  group       SocialGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User                   @relation("GroupJoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  status      GroupJoinRequestStatus @default(PENDING)
  // "groupId:userId" zolang het verzoek openstaat, daarna null: hooguit één
  // open verzoek per persoon per groep, ook bij twee gelijktijdige klikken.
  openKey     String?                @unique
  createdAt   DateTime               @default(now())
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?                  @relation("GroupJoinDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([userId, createdAt])
}
